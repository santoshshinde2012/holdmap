{
  "name": "holdmap-site",
  "private": true,
  "version": "0.0.0",
  "description": "holdmap website: landing page, live demo and guide (https://santoshshinde2012.github.io/holdmap/)",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build:demo": "node scripts/build-demo.mjs",
    "build": "npm run build:demo && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node --test scripts/image-markup.test.mjs && node scripts/check-links.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "test:demo": "node scripts/check-demo.mjs",
    "test:release": "node --test scripts/published-release.test.mjs",
    "test": "npm run test:release && npm run check:links && npm run check:budget && npm run check:seo"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.5",
    "astro": "^7.3.8",
    "lucide-static": "^1.57.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
