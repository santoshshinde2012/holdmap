---
import Base from "./Base.astro";
import Icon from "../components/Icon.astro";
import type { DocLink, Heading } from "../lib/docs";
import { url } from "../lib/site";

interface Props {
  title: string; description: string; html: string; headings: Heading[];
  nav: DocLink[]; current: string; edit: string; note?: string;
}
const { title, description, html, headings, nav, current, edit, note } = Astro.props;
const i = nav.findIndex((n) => n.id === current);
const prev = i > 0 ? nav[i - 1] : null;
const next = i < nav.length - 1 ? nav[i + 1] : null;
const toc = headings.filter((h) => h.depth === 2);
const breadcrumbs = [
  { name: "holdmap", href: url() },
  { name: "Guide", href: url("docs/") },
  ...(current === "index" ? [] : [{ name: title, href: nav[i].href }]),
];
---
<Base title={title} description={description} ogType="article" breadcrumbs={breadcrumbs}>
  <div class="wrap docs">
    <aside class="side" aria-label="Guide">
      <details class="mobile-nav">
        <summary>Guide <span>· {title}</span></summary>
        <ul>{nav.map((n) => <li><a href={n.href} aria-current={n.id === current ? "page" : undefined}>{n.title}</a></li>)}</ul>
      </details>
      <nav class="desk-nav" aria-label="Guide pages">
        <p class="side-title">Guide</p>
        <ul>{nav.map((n) => <li><a href={n.href} aria-current={n.id === current ? "page" : undefined}>{n.title}</a></li>)}</ul>
      </nav>
    </aside>

    <article class="content">
      <header>
        <nav class="crumb" aria-label="Breadcrumb">
          <ol>{breadcrumbs.map((crumb, index) => <li>
            {index === breadcrumbs.length - 1
              ? <span aria-current="page">{crumb.name}</span>
              : <a href={crumb.href}>{crumb.name}</a>}
          </li>)}</ol>
        </nav>
        <h1>{title}</h1>
        <p class="desc">{description}</p>
        {note && <p class="note"><Icon name="Info" size={16} /> <span set:html={note} /></p>}
      </header>
      <div class="prose" set:html={html} />
      <footer class="doc-foot">
        <a class="edit" href={edit}><Icon name="Pencil" size={16} /> Edit this page on GitHub</a>
        <nav class="pager" aria-label="Previous and next page">
          {prev ? <a class="prev" href={prev.href}><small>Previous</small>{prev.title}</a> : <span></span>}
          {next && <a class="next" href={next.href}><small>Next</small>{next.title}</a>}
        </nav>
      </footer>
    </article>

    {toc.length > 1 && (
      <nav class="toc" aria-label="On this page">
        <p class="side-title">On this page</p>
        <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </nav>
    )}
  </div>
</Base>

<style>
  .docs { display: grid; grid-template-columns: 220px minmax(0, 1fr) 200px; gap: 48px; padding-block: 48px 96px; align-items: start; }
  .side, .toc { position: sticky; top: calc(var(--nav-h) + 32px); max-height: calc(100vh - var(--nav-h) - 48px); overflow-y: auto; }
  .side-title { margin: 0 0 12px; font: 600 var(--fs-xs) var(--mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .desk-nav a, .mobile-nav a { display: block; padding: 6px 12px; border-radius: var(--r-sm); color: var(--muted); text-decoration: none; font-size: var(--fs-ui); line-height: 20px; }
  .desk-nav a:hover, .mobile-nav a:hover { color: var(--text); background: var(--surface-2); }
  .desk-nav a[aria-current="page"], .mobile-nav a[aria-current="page"] { color: var(--text); background: var(--surface-2); font-weight: 500; }
  .toc a { display: block; padding: 4px 0 4px 12px; border-left: 1px solid var(--border); color: var(--muted); text-decoration: none; font-size: var(--fs-ui); }
  .toc a:hover { color: var(--text); border-color: var(--text-2); }
  .mobile-nav { display: none; }
  .crumb { margin: 0; font: 500 var(--fs-xs)/16px var(--mono); color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }
  .crumb ol { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .crumb li + li::before { content: "/"; margin-right: 8px; color: var(--muted); }
  .crumb a { color: inherit; text-decoration: none; }
  .crumb a:hover { color: var(--text); text-decoration: underline; }
  h1 { margin: 16px 0 12px; font-size: var(--fs-h2); font-weight: 600; letter-spacing: -0.028em; line-height: 1.15; }
  .desc { margin: 0; max-width: 640px; color: var(--muted); font-size: var(--fs-lg); line-height: 28px; }
  .note { display: flex; gap: 8px; align-items: flex-start; margin: 20px 0 0; padding: 12px 16px; border-radius: var(--r-sm); border: 1px solid var(--border); background: var(--surface); font-size: var(--fs-ui); color: var(--muted); }
  .note :global(svg) { flex: none; margin-top: 4px; color: var(--muted); }
  .note :global(code) { font-size: 0.875em; }
  header { padding-bottom: 28px; margin-bottom: 8px; border-bottom: 1px solid var(--border); }
  .doc-foot { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--border); }
  .edit { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font-size: var(--fs-ui); text-decoration: none; }
  .edit:hover { color: var(--text); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 24px; }
  .pager a { display: grid; gap: 2px; padding: 16px; border-radius: var(--r-md); border: 1px solid var(--border); text-decoration: none; font-weight: 600; }
  .pager a:hover { border-color: var(--border-strong); background: var(--surface); }
  .pager small { font-weight: 400; font-size: var(--fs-sm); color: var(--muted); }
  .next { text-align: right; grid-column: 2; }

  @media (max-width: 1180px) { .docs { grid-template-columns: 200px minmax(0, 1fr); } .toc { display: none; } }
  @media (max-width: 860px) {
    .docs { grid-template-columns: minmax(0, 1fr); gap: 20px; padding-top: 20px; }
    .side { position: static; max-height: none; overflow: visible; }
    .desk-nav { display: none; }
    .mobile-nav { display: block; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--surface); }
    .mobile-nav summary { display: flex; align-items: center; gap: 4px; padding: 12px 16px; cursor: pointer; font-weight: 600; font-size: var(--fs-md); list-style: none; }
    .mobile-nav summary::-webkit-details-marker { display: none; }
    .mobile-nav summary::after {
      content: ""; width: 8px; height: 8px; margin-left: auto; border: solid var(--muted); border-width: 0 1.5px 1.5px 0;
      transform: translateY(-2px) rotate(45deg); transition: transform 160ms var(--ease);
    }
    .mobile-nav[open] summary::after { transform: translateY(2px) rotate(-135deg); }
    .mobile-nav summary span { color: var(--muted); font-weight: 400; }
    .mobile-nav ul { padding: 0 8px 12px; }
  }

  /* Prose */
  .prose { font-size: var(--fs-base); line-height: 28px; color: var(--text-2); }
  .prose :global(h2) { margin: 48px 0 16px; font-size: 24px; font-weight: 600; letter-spacing: -0.018em; line-height: 32px; color: var(--text); scroll-margin-top: 8px; }
  .prose :global(h3) { margin: 32px 0 12px; font-size: var(--fs-lg); font-weight: 600; line-height: 28px; color: var(--text); }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 16px 0; }
  .prose :global(ul), .prose :global(ol) { padding-left: 24px; }
  .prose :global(li) { margin: 8px 0; }
  .prose :global(a) { color: var(--accent-text); text-underline-offset: 3px; text-decoration-color: color-mix(in srgb, var(--accent-text) 40%, transparent); }
  .prose :global(strong) { color: var(--text); }
  .prose :global(:not(pre) > code) { font-size: 0.875em; padding: 0.125em 0.375em; border-radius: var(--r-xs); background: var(--surface-2); color: var(--text); border: 1px solid var(--border); white-space: nowrap; }
  .prose :global(pre) { margin: 24px 0; padding: 16px 20px; border-radius: var(--r-md); font-size: var(--fs-sm); line-height: 22px; overflow-x: auto; border: 1px solid var(--border); font-variant-ligatures: none; }
  .prose :global(pre:not(.astro-code)) { background: var(--term-bg); color: var(--term-text); }
  .prose :global(.astro-code), .prose :global(.astro-code span) { color: var(--shiki-dark) !important; }
  .prose :global(.astro-code) { background-color: var(--term-bg) !important; }
  :global(:root[data-theme="light"]) .prose :global(.astro-code), :global(:root[data-theme="light"]) .prose :global(.astro-code span) { color: var(--shiki-light) !important; }
  /* github-light comments (#6A737D) miss 4.5:1 on the code background; darken them. */
  :global(:root[data-theme="light"]) .prose :global(.astro-code span[style*="#6A737D"]) { color: #57606a !important; }
  :global(:root[data-theme="light"]) .prose :global(.astro-code) { background-color: #f4f4f3 !important; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--fs-md); display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 12px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .prose :global(th) { font: 500 var(--fs-xs) var(--mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .prose :global(td code) { white-space: nowrap; }
</style>
