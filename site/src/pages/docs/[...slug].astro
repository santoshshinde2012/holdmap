---
import { getCollection, type CollectionEntry } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import { editUrl, guide, headingsOf } from "../../lib/docs";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({ params: { slug: entry.id === "index" ? undefined : entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<"docs"> };
const nav = await guide();
---
<Docs
  title={entry.data.title}
  description={entry.data.description}
  html={entry.rendered?.html ?? ""}
  headings={headingsOf(entry)}
  nav={nav}
  current={entry.id}
  edit={editUrl(entry)}
/>
