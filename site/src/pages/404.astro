---
import Base from "../layouts/Base.astro";
import { url } from "../lib/site";
---
<Base title="Page not found" noindex>
  <section class="nf wrap">
    <p class="code">:404</p>
    <h1>Nothing is listening on this port.</h1>
    <p>The page you're looking for isn't here. It may have moved.</p>
    <p class="links"><a class="btn btn-primary" href={url()}>Home</a> <a class="btn btn-ghost" href={url("docs/")}>Read the guide</a></p>
  </section>
</Base>
<style>
  .nf { padding: 120px 0 160px; text-align: center; }
  .code { margin: 0; font: 700 64px var(--mono); background: var(--brand); -webkit-background-clip: text; background-clip: text; color: transparent; }
  h1 { margin: 8px 0 12px; font-size: clamp(28px, 4vw, 40px); letter-spacing: -0.03em; }
  p { color: var(--muted); }
  .links { display: flex; gap: 12px; justify-content: center; margin-top: 28px; }
</style>
