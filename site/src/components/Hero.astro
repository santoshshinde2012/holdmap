---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import PortBay from "./PortBay.astro";
import InstallCommand from "./InstallCommand.astro";
import { downloads, repoUrl, url, version } from "../lib/site";
import shotDark from "../../../docs/screenshots/desktop-overview-dark.png";
import shotLight from "../../../docs/screenshots/desktop-overview-light.png";

const primary = Object.fromEntries(downloads.filter((d) => d.primary).map((d) => [d.os, d.url]));
const alt = "The portwise desktop app: ports grouped by kind, with port 3000 (Next.js, shop-web on feat/checkout) selected and its project, memory, connections and stop plan in the details pane";
const widths = [640, 960, 1280, 1680, 2200];
const sizes = "(max-width: 1180px) calc(100vw - 40px), 1100px";
---
<section class="hero" aria-labelledby="hero-title">
  <PortBay />
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap copy">
    <a class="pill" href={`${repoUrl}/releases/tag/v${version}`}>
      <span class="pill-tag">v{version}</span>
      <span>CLI · TUI · Desktop · MCP</span>
      <Icon name="ArrowRight" size={14} />
    </a>
    <h1 id="hero-title">
      Who's on port<span class="sr-only"> 3000</span><span class="roll" aria-hidden="true" data-roll><span>3000</span></span>?
    </h1>
    <p class="sub">
      portwise shows what's listening on every port, explains <em>why</em> it's busy, and stops the right
      thing safely. One Rust core behind a CLI, a TUI, a desktop app and an MCP server for AI agents.
    </p>
    <div class="cta">
      <InstallCommand id="hero-install" />
      <div class="cta-row">
        <a class="btn btn-ghost" href={url("#install")} data-download data-urls={JSON.stringify(primary)}>
          <Icon name="Download" size={18} />
          <span data-download-label>Download desktop app</span>
        </a>
        <a class="btn btn-link" href={url("#demo")}>
          Try the live demo <Icon name="ArrowRight" size={16} />
        </a>
      </div>
    </div>
    <p class="meta">Free and open source · macOS, Linux and Windows · Local-only, no telemetry</p>
  </div>

  <div class="wrap stage">
    <figure class="window shot">
      <div class="window-bar" aria-hidden="true"><span class="dots"><i></i><i></i><i></i></span><span class="window-title">portwise</span></div>
      <Picture src={shotDark} formats={["avif"]} fallbackFormat="webp" widths={widths} sizes={sizes} alt={alt} loading="eager" decoding="async" pictureAttributes={{ class: "only-dark" }} />
      <Picture src={shotLight} formats={["avif"]} fallbackFormat="webp" widths={widths} sizes={sizes} alt={alt} loading="lazy" decoding="async" pictureAttributes={{ class: "only-light" }} />
    </figure>
    <div class="window term hero-term" role="img" aria-label="Terminal: portwise explain 3000 finds Next.js from shop-web on branch feat/checkout; portwise stop 3000 frees the port in 412 ms.">
      <div class="window-bar" aria-hidden="true"><span class="dots"><i></i><i></i><i></i></span><span class="window-title">~/code/shop-web</span></div>
<pre aria-hidden="true"><span class="p">$</span> portwise explain 3000
<span class="r">●</span> <span class="b">Port 3000 is held by Next.js (node, PID 43000)</span>
<span class="b">  in ~/code/shop-web (branch feat/checkout).</span>
<span class="d">  Listening on 127.0.0.1, ::1 (this machine only).</span>
→ Gracefully stop npm run dev (2 processes)
  and verify port 3000 is free.
<span class="p">$</span> portwise stop 3000 --yes
  <span class="d">· sent SIGTERM to npm (42999), node (43000)</span>
<span class="g">✔</span> <span class="b">:3000 is free (stopped 2 processes)</span> <span class="d">in 412 ms</span><span class="caret"></span></pre>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding: clamp(56px, 9vw, 104px) 0 0; isolation: isolate; }
  .glow {
    position: absolute; z-index: -1; left: 50%; top: 340px; width: min(1100px, 120vw); height: 620px; translate: -50% 0;
    background: radial-gradient(closest-side, rgb(99 102 241 / 0.32), rgb(34 211 238 / 0.10) 55%, transparent);
    filter: blur(20px); pointer-events: none;
  }
  :global(:root[data-theme="light"]) .glow { opacity: 0.55; }
  .copy { position: relative; text-align: center; display: flex; flex-direction: column; align-items: center; }
  .pill {
    display: inline-flex; align-items: center; gap: 10px; height: 34px; padding: 0 12px 0 4px; border-radius: 999px;
    border: 1px solid var(--border-strong); background: color-mix(in srgb, var(--surface) 70%, transparent);
    font-size: 13.5px; color: var(--text-2); text-decoration: none; backdrop-filter: blur(8px);
  }
  .pill:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--border-strong)); color: var(--text); }
  .pill-tag { padding: 3px 9px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font: 600 12px var(--mono); }
  h1 {
    margin: 26px 0 0; font-size: clamp(44px, 8.6vw, 104px); line-height: 0.98; letter-spacing: -0.05em; font-weight: 800;
    font-variation-settings: "opsz" 32; text-wrap: balance;
  }
  .roll {
    --n: 4;
    display: inline-grid; margin-left: 0.22em; vertical-align: bottom; height: 1.04em; overflow: hidden;
    width: calc(var(--n) * (1ch - 0.06em) + 0.04em); transition: width 420ms var(--ease);
    font-family: var(--mono); font-weight: 700; letter-spacing: -0.06em; font-size: 0.92em; text-align: left;
  }
  .roll span {
    grid-area: 1 / 1; display: block;
    background: var(--brand); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .roll :global(span.out) { animation: roll-out 380ms var(--ease) forwards; }
  .roll :global(span.in) { animation: roll-in 420ms var(--ease) both; }
  @keyframes roll-out { to { transform: translateY(-100%); opacity: 0; } }
  @keyframes roll-in { from { transform: translateY(70%); opacity: 0; } }
  .sub { margin: 24px auto 0; max-width: 640px; font-size: clamp(17px, 2vw, 20px); line-height: 1.55; color: var(--muted); text-wrap: pretty; }
  .sub em { color: var(--text-2); font-style: italic; }
  .cta { margin-top: 36px; width: 100%; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .cta-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 14px; }
  .btn-link { color: var(--text-2); padding: 0 10px; }
  .btn-link:hover { color: var(--text); }
  .btn-link :global(svg) { transition: transform 160ms var(--ease); }
  .btn-link:hover :global(svg) { transform: translateX(3px); }
  .meta { margin: 22px 0 0; font-size: 13.5px; color: var(--muted); }

  .stage { position: relative; margin-top: clamp(48px, 7vw, 80px); padding-bottom: clamp(64px, 9vw, 112px); max-width: 1100px; }
  .shot { margin: 0; transform: perspective(2400px) rotateX(9deg); transform-origin: 50% 0; animation: rise 1100ms var(--ease) 120ms both; }
  .shot :global(img) { width: 100%; aspect-ratio: 16 / 10; }
  @keyframes rise { from { transform: perspective(2400px) rotateX(22deg) translateY(30px); opacity: 0; } }
  .hero-term {
    position: absolute; left: -36px; bottom: clamp(24px, 4vw, 56px); width: min(460px, 46%);
    border: 1px solid rgb(255 255 255 / 0.08); animation: slide 900ms var(--ease) 520ms both;
  }
  .hero-term .window-bar { background: #12131a; border-color: rgb(255 255 255 / 0.06); color: #8a91a3; }
  @keyframes slide { from { transform: translate(-24px, 24px); opacity: 0; } }
  pre { margin: 0; padding: 14px 16px 16px; font-size: 12.5px; line-height: 1.62; white-space: pre; overflow: hidden; }
  .caret { display: inline-block; width: 7px; height: 14px; margin-left: 4px; vertical-align: -2px; background: #8e8cff; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  @media (max-width: 1240px) { .hero-term { left: 16px; } }
  @media (max-width: 820px) {
    .shot { transform: none; animation: none; }
    .hero-term { position: relative; left: auto; bottom: auto; width: auto; margin: -28px 12px 0; }
  }
  @media (max-width: 520px) {
    pre { font-size: 11px; }
    .cta-row { flex-direction: column; width: 100%; }
    .cta-row .btn-ghost { width: 100%; }
  }
</style>

<script>
  // Roll the port number in the headline through a few usual suspects.
  const roll = document.querySelector<HTMLElement>("[data-roll]");
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  if (roll && !still.matches) {
    const ports = ["3000", "5173", "5432", "8080", "11434", "4321"];
    let i = 0;
    const tick = () => {
      if (document.hidden) return;
      const cur = roll.querySelector("span:last-child");
      i = (i + 1) % ports.length;
      const next = document.createElement("span");
      next.textContent = ports[i];
      next.className = "in";
      cur?.classList.add("out");
      setTimeout(() => cur?.remove(), 380);
      roll.style.setProperty("--n", String(ports[i].length));
      roll.append(next);
    };
    setInterval(tick, 2600);
  }

  // Point the download button at the visitor's OS (the default link scrolls to all downloads).
  const dl = document.querySelector<HTMLAnchorElement>("[data-download]");
  const os = document.documentElement.dataset.os as "macos" | "windows" | "linux" | undefined;
  if (dl && os) {
    const urls = JSON.parse(dl.dataset.urls ?? "{}") as Record<string, string>;
    const names = { macos: "macOS", windows: "Windows", linux: "Linux" } as const;
    if (urls[os]) {
      dl.href = urls[os];
      dl.querySelector("[data-download-label]")!.textContent = `Download for ${names[os]}`;
    }
  }
</script>
