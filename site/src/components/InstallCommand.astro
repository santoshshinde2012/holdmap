---
// The one-line installer with an OS switch. The visitor's OS is picked before paint (see the
// inline script in Base.astro) so nothing jumps; the buttons work as a tab list.
import Icon from "./Icon.astro";
import { install } from "../lib/site";

interface Props { id: string }
const { id } = Astro.props;
const tabs = [
  { key: "unix", label: "macOS · Linux", cmd: install.sh, prompt: "$" },
  { key: "windows", label: "Windows", cmd: install.ps, prompt: ">" },
];
---
<div class="installer" data-installer>
  <div class="seg" role="tablist" aria-label="Install command for" data-tabs data-tabs-os>
    {tabs.map((t, i) => (
      <button type="button" role="tab" id={`${id}-tab-${t.key}`} aria-controls={`${id}-${t.key}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-key={t.key}>{t.label}</button>
    ))}
  </div>
  {tabs.map((t, i) => (
    <div class="cmd" role="tabpanel" id={`${id}-${t.key}`} aria-labelledby={`${id}-tab-${t.key}`} hidden={i !== 0} data-key={t.key}>
      <code id={`${id}-code-${t.key}`}><span class="prompt" aria-hidden="true">{t.prompt} </span>{t.cmd}</code>
      <button type="button" class="copy" data-copy={t.cmd} aria-label={`Copy the ${t.label} install command`}>
        <Icon name="Copy" size={16} class="i-copy" />
        <Icon name="Check" size={16} class="i-done" />
      </button>
    </div>
  ))}
</div>

<style>
  /* The full command always shows: it wraps instead of truncating. */
  .installer { width: 100%; max-width: 640px; text-align: left; border-radius: var(--r-md); background: var(--surface); border: 1px solid var(--border-strong); overflow: hidden; }
  .seg { display: flex; gap: 20px; padding: 0 16px; border-bottom: 1px solid var(--border); }
  .seg button {
    height: 40px; padding: 0; margin-bottom: -1px; border: 0; border-bottom: 1px solid transparent; background: transparent; cursor: pointer;
    font-size: var(--fs-sm); font-weight: 500; color: var(--muted);
  }
  .seg button[aria-selected="true"] { color: var(--text); border-bottom-color: var(--text); }
  .seg button:hover { color: var(--text); }
  .cmd { display: flex; align-items: flex-start; gap: 12px; padding: 12px 8px 12px 16px; }
  .cmd[hidden] { display: none; }
  code { flex: 1; min-width: 0; padding: 4px 0; font-size: var(--fs-sm); line-height: 24px; color: var(--text); white-space: pre-wrap; overflow-wrap: anywhere; font-variant-ligatures: none; }
  .prompt { color: var(--muted); user-select: none; }
  .copy {
    flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: var(--r-sm); cursor: pointer;
    background: transparent; border: 0; color: var(--muted);
  }
  .copy:hover { color: var(--text); background: var(--surface-2); }
  .copy :global(.i-done) { display: none; color: var(--green); }
  .copy[data-copied] :global(.i-done) { display: block; }
  .copy[data-copied] :global(.i-copy) { display: none; }
</style>
