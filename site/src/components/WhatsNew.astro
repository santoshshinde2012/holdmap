---
import Icon from "./Icon.astro";
import { releaseHighlightsPublished as released, repoUrl, sourceVersion, url, version } from "../lib/site";
const highlights = [
  { icon: "Camera", title: "Keep a still alongside the video", text: "Capture the Holdmap view, choose a screen or window, or borrow the active recording source without another picker. Review and save the PNG locally while video keeps running.", href: url("docs/desktop/#take-a-png-snapshot"), link: "Take a PNG snapshot" },
  { icon: "Network", title: "Read the service graph at a glance", text: "Compact disconnected services, readable starting zoom and a full canvas make local relationships easier to explore. Search services, ports and PIDs while keeping observed neighbors in context.", href: url("docs/desktop/#service-graph-and-cluster-grouping"), link: "Explore the service graph" },
  { icon: "Layers", title: "Understand each capability", text: "Explore declared skill purposes, retain the source Map and Compare observed definitions. Purpose, Source, Evidence and Activity keep file presence distinct from loading, approval and use.", href: url("docs/agents/#mcp-and-skills"), link: "Explore MCP & skills" },
];
---
<section id="whats-new" class="section" aria-labelledby="release-title">
  <div class="wrap">
    <div class="section-head head-row">
      <div>
        <span class="eyebrow">Release highlights</span>
        <h2 class="h2" id="release-title">{released ? `${sourceVersion} is here.` : `${sourceVersion} release preparation.`} <span class="soft">Capture, explore, understand.</span></h2>
      </div>
      <a class="link-arrow" href={url("docs/whats-new/")}>What's new <Icon name="ArrowRight" size={16} /></a>
    </div>
    <ul class="highlights" role="list">
      {highlights.map((item) => (
        <li class="card">
          <Icon name={item.icon} size={20} />
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <a class="link-arrow" href={item.href}>{item.link} <Icon name="ArrowRight" size={16} /></a>
        </li>
      ))}
    </ul>
    <p class="release-note">{sourceVersion} adds PNG snapshots, the readable service graph and the capability explorer. {released ? <a href={`${repoUrl}/releases/tag/v${sourceVersion}`}>Read the full {sourceVersion} release notes</a> : <Fragment>Installers are pending; downloads remain on the published v{version} release. <a href={`${repoUrl}/blob/main/CHANGELOG.md`}>Read the changelog</a></Fragment>}.</p>
  </div>
</section>

<style>
  .highlights { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; padding: 0; margin: 0; list-style: none; }
  .card { display: flex; flex-direction: column; align-items: flex-start; padding: 28px; min-width: 0; }
  .card > :global(svg) { color: var(--muted); }
  h3 { margin: 20px 0 12px; font-size: var(--fs-lg); line-height: 28px; font-weight: 600; letter-spacing: -0.012em; }
  .card p { margin: 0 0 24px; font-size: var(--fs-md); line-height: 24px; color: var(--muted); }
  .card .link-arrow { margin-top: auto; }
  .release-note { margin: 24px 0 0; color: var(--muted); font-size: var(--fs-ui); line-height: 24px; }
  .release-note a { color: var(--text-2); }
  @media (max-width: 860px) { .highlights { grid-template-columns: minmax(0, 1fr); } .card { padding: 24px; } }
</style>
