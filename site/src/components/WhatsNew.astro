---
import Icon from "./Icon.astro";
import { releaseHighlightsPublished as released, repoUrl, sourceVersion, url, version } from "../lib/site";
const highlights = [
  { icon: "LayoutGrid", title: "One card per agent", text: "Home shows each agent once, with its projects, ports, MCP servers and skills. The Agents map is the spatial picture of the same report.", href: url("docs/desktop/"), link: "Open Home" },
  { icon: "Layers", title: "Details that fold in place", text: "Readings, facts, access, ports and graph connections fold on the same screen. Each Needs you row opens its explanation in the row.", href: url("docs/desktop/"), link: "See the desktop" },
  { icon: "Activity", title: "A numbered menu bar", text: "Ports, Network, Needs and Dev stay on screen. Choosing a count scrolls to that reading, and each agent shows its share of the RAM.", href: url("docs/desktop/#menu-bar-and-tray"), link: "Menu bar and tray" },
];
---
<section id="whats-new" class="section" aria-labelledby="release-title">
  <div class="wrap">
    <div class="section-head head-row">
      <div>
        <span class="eyebrow">Release highlights</span>
        <h2 class="h2" id="release-title">{released ? `${sourceVersion} is here.` : `${sourceVersion} release preparation.`} <span class="soft">A clearer view of everything running.</span></h2>
      </div>
      <a class="link-arrow" href={url("docs/whats-new/")}>What's new <Icon name="ArrowRight" size={16} /></a>
    </div>
    <ul class="highlights" role="list">
      {highlights.map((item) => (
        <li class="card">
          <Icon name={item.icon} size={20} />
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <a class="link-arrow" href={item.href}>{item.link} <Icon name="ArrowRight" size={16} /></a>
        </li>
      ))}
    </ul>
    <p class="release-note">{sourceVersion} shows Home as cards, folds details in place, and keeps the menu bar a numbered view. {released ? <a href={`${repoUrl}/releases/tag/v${sourceVersion}`}>Read the full {sourceVersion} release notes</a> : <Fragment>Installers are pending; downloads remain on the published v{version} release. <a href={`${repoUrl}/blob/main/CHANGELOG.md`}>Read the changelog</a></Fragment>}.</p>
  </div>
</section>

<style>
  .highlights { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; padding: 0; margin: 0; list-style: none; }
  .card { display: flex; flex-direction: column; align-items: flex-start; padding: 28px; min-width: 0; }
  .card > :global(svg) { color: var(--muted); }
  h3 { margin: 20px 0 12px; font-size: var(--fs-lg); line-height: 28px; font-weight: 600; letter-spacing: -0.012em; }
  .card p { margin: 0 0 24px; font-size: var(--fs-md); line-height: 24px; color: var(--muted); }
  .card .link-arrow { margin-top: auto; }
  .release-note { margin: 24px 0 0; color: var(--muted); font-size: var(--fs-ui); line-height: 24px; }
  .release-note a { color: var(--text-2); }
  @media (max-width: 860px) { .highlights { grid-template-columns: minmax(0, 1fr); } .card { padding: 24px; } }
</style>
