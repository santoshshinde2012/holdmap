---
import Icon from "./Icon.astro";
import { repoUrl, url, version } from "../lib/site";

// Feature availability belongs to this release, even while a later version is assembling.
const [publishedMajor, publishedMinor] = version.split(".").map(Number);
const released = publishedMajor > 0 || publishedMinor >= 8;
const highlights = [
  { icon: "Bot", title: "Map local MCP servers and skills", text: "Opt into MCP & skills to explore discovered definitions around their agents. Select a card for its source, evidence and optional skill purpose. Running candidates stay separate.", href: url("docs/agents/#mcp-and-skills"), link: "Explore MCP & skills" },
  { icon: "Layers", title: "Keep reported usage in context", text: "Calls labels reported MCP server aliases and explicit Claude skill activations. Configuration presence, running processes and recorded activity stay distinct; matching names never prove use.", href: url("docs/agents/#desktop-flow-connections-and-calls"), link: "Understand recorded activity" },
  { icon: "Monitor", title: "Know which desktop copy is open", text: "Settings → About shows the running app's version, architecture and location, with download and installation help. Update the desktop separately from the CLI.", href: url("docs/desktop/#first-open"), link: "Update the desktop app" },
];
---
<section id="whats-new" class="section" aria-labelledby="release-title">
  <div class="wrap">
    <div class="section-head head-row">
      <div>
        <span class="eyebrow">Release highlights</span>
        <h2 class="h2" id="release-title">{released ? "0.8.0 is here." : "Coming in 0.8.0."} <span class="soft">MCP and skills, mapped.</span></h2>
      </div>
      <a class="link-arrow" href={url("docs/whats-new/")}>What's new <Icon name="ArrowRight" size={16} /></a>
    </div>
    <ul class="highlights" role="list">
      {highlights.map((item) => (
        <li class="card">
          <Icon name={item.icon} size={20} />
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <a class="link-arrow" href={item.href}>{item.link} <Icon name="ArrowRight" size={16} /></a>
        </li>
      ))}
    </ul>
    <p class="release-note">0.8.0 adds local capability maps, reported usage labels and clearer desktop updates, with recording startup and cleanup fixes. {released ? <a href={`${repoUrl}/releases/tag/v0.8.0`}>Read the full 0.8.0 release notes</a> : <Fragment>The published downloads remain on v{version} while the release is prepared. <a href={`${repoUrl}/blob/main/CHANGELOG.md`}>Read the changelog</a></Fragment>}.</p>
  </div>
</section>

<style>
  .highlights { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; padding: 0; margin: 0; list-style: none; }
  .card { display: flex; flex-direction: column; align-items: flex-start; padding: 28px; min-width: 0; }
  .card > :global(svg) { color: var(--muted); }
  h3 { margin: 20px 0 12px; font-size: var(--fs-lg); line-height: 28px; font-weight: 600; letter-spacing: -0.012em; }
  .card p { margin: 0 0 24px; font-size: var(--fs-md); line-height: 24px; color: var(--muted); }
  .card .link-arrow { margin-top: auto; }
  .release-note { margin: 24px 0 0; color: var(--muted); font-size: var(--fs-ui); line-height: 24px; }
  .release-note a { color: var(--text-2); }
  @media (max-width: 860px) { .highlights { grid-template-columns: minmax(0, 1fr); } .card { padding: 24px; } }
</style>
