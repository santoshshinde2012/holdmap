---
import Icon from "./Icon.astro";
import { releaseHighlightsPublished as released, repoUrl, sourceVersion, url, version } from "../lib/site";
const highlights = [
  { icon: "ShieldCheck", title: "Scan your agents' skills", text: "Opt-in analyzers: SkillSpector, a built-in OSV.dev lookup and presets for Cisco Skill Scanner, OSV-Scanner, Trivy and Bandit. Each is off until you approve exactly what it gets, and runs on a sandboxed copy.", href: url("docs/analyzers/"), link: "Analyzers guide" },
  { icon: "Plug", title: "Add any MCP server in three steps", text: "Source, Tools, Review: see each tool's full description, hidden characters and the server's own hints before you choose. It's added off, and pinned so a changed tool stops the next run.", href: url("docs/analyzers/#your-own-analyzers"), link: "Add your own analyzer" },
  { icon: "LayoutDashboard", title: "Findings where you work", text: "Agents → Security groups findings by severity with the fix, location and evidence. Needs you, holdmap needs and the MCP tools list_insights and list_needs show the same list.", href: url("docs/agents/"), link: "Agents and Security" },
];
---
<section id="whats-new" class="section" aria-labelledby="release-title">
  <div class="wrap">
    <div class="section-head head-row">
      <div>
        <span class="eyebrow">Release highlights</span>
        <h2 class="h2" id="release-title">{released ? `${sourceVersion} is here.` : `${sourceVersion} release preparation.`} <span class="soft">Scan, review, approve.</span></h2>
      </div>
      <a class="link-arrow" href={url("docs/whats-new/")}>What's new <Icon name="ArrowRight" size={16} /></a>
    </div>
    <ul class="highlights" role="list">
      {highlights.map((item) => (
        <li class="card">
          <Icon name={item.icon} size={20} />
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <a class="link-arrow" href={item.href}>{item.link} <Icon name="ArrowRight" size={16} /></a>
        </li>
      ))}
    </ul>
    <p class="release-note">{sourceVersion} adds opt-in analyzers, a guided add-your-own flow and the Security workspace. {released ? <a href={`${repoUrl}/releases/tag/v${sourceVersion}`}>Read the full {sourceVersion} release notes</a> : <Fragment>Installers are pending; downloads remain on the published v{version} release. <a href={`${repoUrl}/blob/main/CHANGELOG.md`}>Read the changelog</a></Fragment>}.</p>
  </div>
</section>

<style>
  .highlights { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; padding: 0; margin: 0; list-style: none; }
  .card { display: flex; flex-direction: column; align-items: flex-start; padding: 28px; min-width: 0; }
  .card > :global(svg) { color: var(--muted); }
  h3 { margin: 20px 0 12px; font-size: var(--fs-lg); line-height: 28px; font-weight: 600; letter-spacing: -0.012em; }
  .card p { margin: 0 0 24px; font-size: var(--fs-md); line-height: 24px; color: var(--muted); }
  .card .link-arrow { margin-top: auto; }
  .release-note { margin: 24px 0 0; color: var(--muted); font-size: var(--fs-ui); line-height: 24px; }
  .release-note a { color: var(--text-2); }
  @media (max-width: 860px) { .highlights { grid-template-columns: minmax(0, 1fr); } .card { padding: 24px; } }
</style>
