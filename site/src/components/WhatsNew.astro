---
import Icon from "./Icon.astro";
import { releaseHighlightsPublished as released, repoUrl, sourceVersion, url, version } from "../lib/site";
const highlights = [
  { icon: "Download", title: "Guided installs, visible runs", text: "Install an analyzer after you see exactly what it fetches and reads, watch each run's progress, and get a sortable results table with exports of what's on screen.", href: url("docs/analyzers/"), link: "Analyzers" },
  { icon: "Fingerprint", title: "Know when a skill changes", text: "Every skill gets a fingerprint. Holdmap flags skills changed since you trusted them, shows what changed by file name and size, and scores risk per agent and folder.", href: url("docs/analyzers/#skill-trust-and-top-risks"), link: "Skill trust and risks" },
  { icon: "CalendarClock", title: "New since last run", text: "See what is new and what was fixed after each rescan, schedule offline rescans while the app is open, and fail CI only on new findings.", href: url("docs/whats-new/"), link: "What's new" },
];
---
<section id="whats-new" class="section" aria-labelledby="release-title">
  <div class="wrap">
    <div class="section-head head-row">
      <div>
        <span class="eyebrow">Release highlights</span>
        <h2 class="h2" id="release-title">{released ? `${sourceVersion} is here.` : `${sourceVersion} release preparation.`} <span class="soft">Trust the skills your agents load.</span></h2>
      </div>
      <a class="link-arrow" href={url("docs/whats-new/")}>What's new <Icon name="ArrowRight" size={16} /></a>
    </div>
    <ul class="highlights" role="list">
      {highlights.map((item) => (
        <li class="card">
          <Icon name={item.icon} size={20} />
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <a class="link-arrow" href={item.href}>{item.link} <Icon name="ArrowRight" size={16} /></a>
        </li>
      ))}
    </ul>
    <p class="release-note">{sourceVersion} turns skill analyzers into a full workflow: install, run, compare, trust. {released ? <a href={`${repoUrl}/releases/tag/v${sourceVersion}`}>Read the full {sourceVersion} release notes</a> : <Fragment>Installers are pending; downloads remain on the published v{version} release. <a href={`${repoUrl}/blob/main/CHANGELOG.md`}>Read the changelog</a></Fragment>}.</p>
  </div>
</section>

<style>
  .highlights { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; padding: 0; margin: 0; list-style: none; }
  .card { display: flex; flex-direction: column; align-items: flex-start; padding: 28px; min-width: 0; }
  .card > :global(svg) { color: var(--muted); }
  h3 { margin: 20px 0 12px; font-size: var(--fs-lg); line-height: 28px; font-weight: 600; letter-spacing: -0.012em; }
  .card p { margin: 0 0 24px; font-size: var(--fs-md); line-height: 24px; color: var(--muted); }
  .card .link-arrow { margin-top: auto; }
  .release-note { margin: 24px 0 0; color: var(--muted); font-size: var(--fs-ui); line-height: 24px; }
  .release-note a { color: var(--text-2); }
  @media (max-width: 860px) { .highlights { grid-template-columns: minmax(0, 1fr); } .card { padding: 24px; } }
</style>
