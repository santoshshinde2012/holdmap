---
import Icon from "./Icon.astro";
import { securityUrl } from "../lib/site";
const items = [
  { icon: "HardDrive", title: "Local only", text: "Talks to localhost, to hosts you ssh to, and (desktop) GitHub Releases for updates. Nothing else." },
  { icon: "EyeOff", title: "No telemetry", text: "No analytics, no accounts, no tracking. This site doesn't track you either." },
  { icon: "KeyRound", title: "Secrets redacted", text: "Passwords and tokens in command lines are hidden in every output, JSON and MCP results included." },
  { icon: "ShieldCheck", title: "Protected by default", text: "The OS, shells, IDEs and AI agents are refused unless you pass --allow-protected. MCP always refuses." },
];
---
<section class="security" aria-labelledby="sec-title">
  <div class="wrap inner">
    <div class="head">
      <span class="eyebrow">Security and privacy</span>
      <h2 id="sec-title">It stops processes, so it's careful.</h2>
      <p>A PID-reuse guard, <code>--dry-run</code> for every plan, history only you can read, and a locked-down desktop webview. <a href={securityUrl}>Security policy</a></p>
    </div>
    <ul role="list">
      {items.map((i) => (
        <li>
          <Icon name={i.icon} size={20} />
          <h3>{i.title}</h3>
          <p>{i.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .security { padding-block: clamp(56px, 8vw, 96px); border-block: 1px solid var(--border); background:
    radial-gradient(800px 300px at 15% 0%, rgb(71 209 140 / 0.08), transparent 70%), var(--bg-2); }
  .inner { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  h2 { margin: 12px 0; font-size: clamp(26px, 3vw, 36px); line-height: 1.12; letter-spacing: -0.03em; }
  .head p { margin: 0; color: var(--muted); }
  .head code { font-size: 0.88em; padding: 1px 5px; border-radius: 5px; background: var(--surface-2); color: var(--text-2); }
  .head a { color: var(--text-2); }
  .eyebrow { color: var(--green); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 32px; }
  li :global(svg) { color: var(--green); }
  h3 { margin: 12px 0 6px; font-size: 16px; }
  li p { margin: 0; color: var(--muted); font-size: 14.5px; }
  @media (max-width: 900px) { .inner { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 560px) { ul { grid-template-columns: minmax(0, 1fr); } }
</style>
