---
// The frameworks and services portwise recognises, as a rail of "bound" sockets.
const items: [string, string][] = [
  ["3000", "Next.js"], ["5173", "Vite"], ["4321", "Astro"], ["4200", "Angular"], ["8000", "Django"], ["4000", "Phoenix"],
  ["8080", "Spring Boot"], ["6006", "Storybook"], ["8888", "Jupyter"], ["5432", "PostgreSQL"], ["3306", "MySQL"],
  ["6379", "Redis"], ["27017", "MongoDB"], ["9092", "Kafka"], ["9200", "Elasticsearch"], ["11434", "Ollama"],
];
---
<section class="rail" aria-labelledby="rail-title">
  <div class="wrap">
    <h2 id="rail-title">Recognises what's on your ports, from dev servers to databases and containers</h2>
    <ul role="list">
      {items.map(([port, name], i) => (
        <li style={`--i:${i}`}><span class="led" aria-hidden="true"></span><code>:{port}</code>{name}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .rail { padding: 8px 0 clamp(40px, 6vw, 72px); }
  h2 { margin: 0 0 20px; text-align: center; font-size: 14px; font-weight: 500; color: var(--muted); letter-spacing: 0; }
  ul { list-style: none; margin: 0 auto; padding: 0; max-width: 1040px; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  li { display: inline-flex; align-items: center; gap: 8px; height: 34px; padding: 0 12px 0 10px; border-radius: 10px; border: 1px solid var(--border); background: color-mix(in srgb, var(--surface) 70%, transparent); font-size: 13.5px; color: var(--text-2); }
  code { font-size: 12.5px; color: var(--accent); }
  .led { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 18%, transparent); animation: led 4.8s ease-in-out infinite; animation-delay: calc(var(--i) * -0.6s); }
  @keyframes led { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
</style>
