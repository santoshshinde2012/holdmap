---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import { url } from "../lib/site";
import stopDark from "../assets/ui/ui-stop-dark.png";
import stopLight from "../assets/ui/ui-stop-light.png";
import detailDark from "../assets/ui/ui-detail-dark.png";
import detailLight from "../assets/ui/ui-detail-light.png";
import rowsDark from "../assets/ui/ui-rows-dark.png";
import rowsLight from "../assets/ui/ui-rows-light.png";
import paletteDark from "../assets/ui/ui-palette-dark.png";
import paletteLight from "../assets/ui/ui-palette-light.png";
import graphDark from "../assets/ui/ui-graph-dark.png";
import graphLight from "../assets/ui/ui-graph-light.png";

// Real crops of the desktop app (captured from the live demo at 3x), shown at a fixed CSS width.
type Shot = { dark: ImageMetadata; light: ImageMetadata; w: number; alt: string };
const shots: Record<string, Shot> = {
  stop: { dark: stopDark, light: stopLight, w: 440, alt: "The stop dialog: the plan for port 3000, with Cancel and Stop buttons." },
  detail: { dark: detailDark, light: detailLight, w: 440, alt: "Port 3000's detail pane: shop-web, Next.js, branch feat/checkout, and a recommended action." },
  rows: { dark: rowsDark, light: rowsLight, w: 820, alt: "The port list with project names, frameworks, branches and memory." },
  palette: { dark: paletteDark, light: paletteLight, w: 560, alt: "The command palette filtered to stop actions." },
  graph: { dark: graphDark, light: graphLight, w: 720, alt: "The service graph: shop-web calls shop-api, which uses redis and db." },
};
const widths = (w: number) => [w, w * 2, w * 3];
---
<section id="features" class="section" aria-labelledby="features-title">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Features</span>
      <h2 class="h2" id="features-title">Knows what's behind every port. <span class="soft">Stops only what it should.</span></h2>
    </div>

    <ul class="bento" role="list">
      <li class="card span-2">
        <div class="copy">
          <h3>A safe stop, with protection</h3>
          <p>Preview the plan, stop the whole dev-server tree (SIGTERM, then SIGKILL) and check the port is free. The OS, shells, IDEs and AI agents are protected.</p>
        </div>
        <div class="visual stage">{["dark", "light"].map((t) => (
          <Picture src={shots.stop[t as "dark"]} formats={["avif"]} fallbackFormat="webp" widths={widths(shots.stop.w)} sizes={`${shots.stop.w}px`} alt={shots.stop.alt} loading="lazy" class="float" pictureAttributes={{ class: `only-${t}` }} />
        ))}</div>
      </li>
      <li class="card">
        <div class="copy">
          <h3>Why it's busy, in plain English</h3>
          <p>A dev-server tree, a container, a system service, AirPlay Receiver, <code>TIME_WAIT</code> or another user.</p>
        </div>
        <div class="visual bleed">{["dark", "light"].map((t) => (
          <Picture src={shots.detail[t as "dark"]} formats={["avif"]} fallbackFormat="webp" widths={widths(shots.detail.w)} sizes={`${shots.detail.w}px`} alt={shots.detail.alt} loading="lazy" style={`width:${shots.detail.w}px`} pictureAttributes={{ class: `only-${t}` }} />
        ))}</div>
      </li>
      <li class="card span-2">
        <div class="copy">
          <h3>Project and branch aware</h3>
          <p>The project, git branch and framework (Next.js, Vite, Django, Postgres…) or the Docker, Podman or OrbStack container behind each port, with real memory for the whole app.</p>
        </div>
        <div class="visual bleed short">{["dark", "light"].map((t) => (
          <Picture src={shots.rows[t as "dark"]} formats={["avif"]} fallbackFormat="webp" widths={widths(shots.rows.w)} sizes={`${shots.rows.w}px`} alt={shots.rows.alt} loading="lazy" style={`width:${shots.rows.w}px`} pictureAttributes={{ class: `only-${t}` }} />
        ))}</div>
      </li>
      <li class="card">
        <div class="copy">
          <h3>Everything from the keyboard</h3>
          <p>A command palette for every port and action, with shortcuts that match the CLI.</p>
        </div>
        <div class="visual bleed short">{["dark", "light"].map((t) => (
          <Picture src={shots.palette[t as "dark"]} formats={["avif"]} fallbackFormat="webp" widths={widths(shots.palette.w)} sizes={`${shots.palette.w}px`} alt={shots.palette.alt} loading="lazy" style={`width:${shots.palette.w}px`} pictureAttributes={{ class: `only-${t}` }} />
        ))}</div>
      </li>
      <li class="card span-3 split">
        <div class="copy">
          <h3>The service graph</h3>
          <p>Which local services talk to which, grouped by Compose, Kubernetes or workspace. Stop a whole stack in dependency order.</p>
          <a class="link-arrow" href={url("docs/projects/")}>Project stacks <Icon name="ArrowRight" size={16} /></a>
        </div>
        <div class="visual graph">{["dark", "light"].map((t) => (
          <Picture src={shots.graph[t as "dark"]} formats={["avif"]} fallbackFormat="webp" widths={widths(shots.graph.w)} sizes={`(max-width: 1000px) calc(100vw - 80px), ${shots.graph.w}px`} alt={shots.graph.alt} loading="lazy" pictureAttributes={{ class: `only-${t}` }} />
        ))}</div>
      </li>
      <li class="card span-2">
        <div class="copy">
          <h3>Agents, tools and apps</h3>
          <p>Claude Code, Cursor, Copilot, Docker Desktop and more: the folders they work in, the ports they started, what they talk to, and their access — each fact marked seen, inferred or unknown. Reveal a folder, open it in your editor, or stop only what that agent started.</p>
        </div>
        <pre class="snippet term" tabindex="0" aria-label="Example agents command"><span class="p">$</span> portwise agents claude --stop-ports --dry-run
<span class="c">plan</span> :3001 (Claude Code)
  Stop the Vite tree holding :3001
<span class="d">Dry run: nothing was changed.</span></pre>
      </li>
      <li class="card">
        <div class="copy">
          <h3>MCP for AI agents</h3>
          <p>Claude, Cursor and VS Code can list ports, see which agents run where, find a free one and stop their own servers. Never protected ones.</p>
        </div>
        <pre class="snippet term" tabindex="0" aria-label="Example MCP tool call"><span class="d">{"// tool call"}</span>
{"{"} <span class="c">"tool"</span>: <span class="g">"find_free_port"</span>,
  <span class="c">"near"</span>: <span class="y">3000</span> {"}"}
<span class="d">→</span> {"{"} <span class="c">"port"</span>: <span class="y">3002</span> {"}"}</pre>
      </li>
      <li class="card">
        <div class="copy">
          <h3>Scriptable to the core</h3>
          <p>Every read command speaks <code>--json</code>, every action has <code>--dry-run</code>, and exit codes mean something.</p>
        </div>
        <pre class="snippet term" tabindex="0" aria-label="Example CLI command"><span class="p">$</span> portwise list --json \
    | jq '.[0].project'
<span class="g">"shop-web"</span></pre>
      </li>
      <li class="card">
        <div class="copy">
          <h3>A TUI, over SSH too</h3>
          <p>Run <code>portwise</code> for a fast terminal UI. <code>portwise ssh devbox</code> reads another machine without installing anything there.</p>
        </div>
        <pre class="snippet term" tabindex="0" aria-label="Example SSH command"><span class="p">$</span> portwise ssh devbox
<span class="d">connected · 14 ports · linux</span></pre>
      </li>
    </ul>
  </div>
</section>

<style>
  .bento { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .card { display: flex; flex-direction: column; overflow: hidden; min-width: 0; }
  .span-2 { grid-column: span 2; }
  .span-3 { grid-column: span 3; }
  .copy { padding: 32px 32px 0; }
  h3 { margin: 0 0 8px; font-size: var(--fs-lg); line-height: 28px; font-weight: 600; letter-spacing: -0.012em; }
  p { margin: 0; max-width: 520px; color: var(--muted); font-size: var(--fs-md); line-height: 24px; }
  .copy .link-arrow { margin-top: 20px; }

  .visual { position: relative; flex: 1; min-height: 320px; margin-top: 32px; overflow: hidden; }
  .visual.short { min-height: 264px; }
  .visual :global(img) { display: block; max-width: none; height: auto; }
  .bleed :global(img) {
    position: absolute; left: 32px; top: 0;
    border: 1px solid var(--border-strong); border-right: 0; border-bottom: 0; border-top-left-radius: var(--r-md);
  }
  .stage { display: grid; place-items: center; padding: 0 32px 32px; min-height: 0; }
  .stage :global(img) { width: min(440px, 100%); border-radius: var(--r-lg); box-shadow: var(--shadow); }

  .split { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
  .split .copy { padding: 32px; }
  .graph { margin: 0; padding: 32px 32px 32px 0; min-height: 0; }
  .graph :global(img) { width: 720px; border-radius: var(--r-md); border: 1px solid var(--border); }

  .snippet { margin: auto 16px 16px; padding: 16px; border-radius: var(--r-md); white-space: pre; overflow-x: auto; border: 1px solid var(--term-line-strong); }
  .card:has(.snippet) .copy { padding-bottom: 24px; }

  @media (max-width: 1100px) {
    .split { grid-template-columns: minmax(0, 1fr); }
    .graph { padding: 0 32px 32px; }
    .graph :global(img) { width: 100%; }
  }
  @media (max-width: 1000px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .span-3 { grid-column: span 2; }
  }
  @media (max-width: 640px) {
    .bento { grid-template-columns: minmax(0, 1fr); }
    .span-2, .span-3 { grid-column: auto; }
    .copy, .split .copy { padding: 24px 24px 0; }
    .visual { min-height: 240px; margin-top: 24px; }
    .bleed :global(img) { left: 24px; }
    .stage { padding: 0 24px 24px; }
    .graph { padding: 0 24px 24px; }
  }
</style>
