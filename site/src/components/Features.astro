---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import { url } from "../lib/site";
import stopDark from "../assets/ui/ui-stop-dark.png";
import stopLight from "../assets/ui/ui-stop-light.png";
import detailDark from "../assets/ui/ui-detail-dark.png";
import detailLight from "../assets/ui/ui-detail-light.png";
import rowsDark from "../assets/ui/ui-rows-dark.png";
import rowsLight from "../assets/ui/ui-rows-light.png";
import paletteDark from "../assets/ui/ui-palette-dark.png";
import paletteLight from "../assets/ui/ui-palette-light.png";
import graphDark from "../assets/ui/ui-graph-dark.png";
import graphLight from "../assets/ui/ui-graph-light.png";
import agentsShot from "../../../docs/screenshots/desktop-agents-dark.png";
import agentsLight from "../../../docs/screenshots/desktop-agents-light.png";
import agentFlowDark from "../../../docs/screenshots/desktop-agent-flow-dark.png";
import agentFlowLight from "../../../docs/screenshots/desktop-agent-flow-light.png";
import screenRecordDark from "../../../docs/screenshots/desktop-screen-record-dark.png";
import screenRecordLight from "../../../docs/screenshots/desktop-screen-record-light.png";

// Real crops of the desktop app (captured from the live demo at 3x), shown at a fixed CSS width.
type Shot = { dark: ImageMetadata; light: ImageMetadata; w: number; alt: string };
const shots: Record<string, Shot> = {
  stop: { dark: stopDark, light: stopLight, w: 440, alt: "The stop dialog: the plan for port 3000, with Cancel and Stop buttons." },
  detail: { dark: detailDark, light: detailLight, w: 440, alt: "Port 3000's detail pane: shop-web, Next.js, branch feat/checkout, and a recommended action." },
  rows: { dark: rowsDark, light: rowsLight, w: 820, alt: "The port list with project names, frameworks, branches and memory." },
  palette: { dark: paletteDark, light: paletteLight, w: 560, alt: "The command palette filtered to stop actions." },
  graph: { dark: graphDark, light: graphLight, w: 720, alt: "The service graph: observed connections between shop-web, shop-api, redis and db." },
};
const widths = (w: number) => [w, w * 2, w * 3];
---
<section id="features" class="section" aria-labelledby="features-title">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Features</span>
      <h2 class="h2" id="features-title">Agents, tools and every port. <span class="soft">Stops only what it should.</span></h2>
    </div>

    <ul class="bento" role="list">
      <li class="card span-2">
        <div class="copy">
          <h3>A safe stop, with protection</h3>
          <p>Preview the plan, stop the whole dev-server tree (SIGTERM, then SIGKILL) and check the port is free. The OS, shells, IDEs and AI agents are protected.</p>
        </div>
        <div class="visual stage">{["dark", "light"].map((t) => (
          <Picture src={shots.stop[t as "dark"]} formats={["avif"]} fallbackFormat="webp" widths={widths(shots.stop.w)} sizes={`${shots.stop.w}px`} alt={shots.stop.alt} loading="lazy" class="float" pictureAttributes={{ class: `only-${t}` }} />
        ))}</div>
      </li>
      <li class="card">
        <div class="copy">
          <h3>Why it's busy, in plain English</h3>
          <p>A dev-server tree, a container, a system service, AirPlay Receiver, <code>TIME_WAIT</code> or another user.</p>
        </div>
        <div class="visual bleed">{["dark", "light"].map((t) => (
          <Picture src={shots.detail[t as "dark"]} formats={["avif"]} fallbackFormat="webp" widths={widths(shots.detail.w)} sizes={`${shots.detail.w}px`} alt={shots.detail.alt} loading="lazy" style={`width:${shots.detail.w}px`} pictureAttributes={{ class: `only-${t}` }} />
        ))}</div>
      </li>
      <li class="card span-2">
        <div class="copy">
          <h3>Project and branch aware</h3>
          <p>The project, git branch and framework (Next.js, Vite, Django, Postgres…) or the Docker, Podman or OrbStack container behind each port, with real memory for the whole app.</p>
        </div>
        <div class="visual bleed short">{["dark", "light"].map((t) => (
          <Picture src={shots.rows[t as "dark"]} formats={["avif"]} fallbackFormat="webp" widths={widths(shots.rows.w)} sizes={`${shots.rows.w}px`} alt={shots.rows.alt} loading="lazy" style={`width:${shots.rows.w}px`} pictureAttributes={{ class: `only-${t}` }} />
        ))}</div>
      </li>
      <li class="card">
        <div class="copy">
          <h3>Everything from the keyboard</h3>
          <p>A searchable command palette and predictable arrow navigation. Turn off single-key shortcuts while keeping modifier shortcuts and native controls available.</p>
        </div>
        <div class="visual bleed short">{["dark", "light"].map((t) => (
          <Picture src={shots.palette[t as "dark"]} formats={["avif"]} fallbackFormat="webp" widths={widths(shots.palette.w)} sizes={`${shots.palette.w}px`} alt={shots.palette.alt} loading="lazy" style={`width:${shots.palette.w}px`} pictureAttributes={{ class: `only-${t}` }} />
        ))}</div>
      </li>
      <li class="card span-3 split">
        <div class="copy">
          <h3>The service graph</h3>
          <p>Which local services talk to which, grouped by Compose, Kubernetes or workspace. Stop a whole stack in dependency order.</p>
          <a class="link-arrow" href={url("docs/projects/")}>Project stacks <Icon name="ArrowRight" size={16} /></a>
        </div>
        <div class="visual graph">{["dark", "light"].map((t) => (
          <Picture src={shots.graph[t as "dark"]} formats={["avif"]} fallbackFormat="webp" widths={widths(shots.graph.w)} sizes={`(max-width: 1000px) calc(100vw - 80px), ${shots.graph.w}px`} alt={shots.graph.alt} loading="lazy" pictureAttributes={{ class: `only-${t}` }} />
        ))}</div>
      </li>
      <li class="card span-3 split agents">
        <div class="copy">
          <h3>Computer → Footprint → Project</h3>
          <p>Zoom from this computer and its agents to their folders, tools, ports and a single source tree. Inspect memory, CPU, parent processes and access, with each fact marked seen, inferred or unknown. Reveal a folder, open it in your editor, or stop only the services an agent started.</p>
          <p class="source-note">The capability explorer leads with declared skill purposes in Explore, retains source relationships in Map, and shows exact observed definitions in Compare. File presence does not prove loading, approval or use.</p>
          <a class="link-arrow" href={url("docs/agents/#desktop-and-tui")}>Explore the agent map <Icon name="ArrowRight" size={16} /></a>
          <a class="link-arrow" href={url("docs/agents/#mcp-and-skills")}>MCP and skills explorer <Icon name="ArrowRight" size={16} /></a>
          <pre class="snippet term inline" tabindex="0" aria-label="Example agents command"><span class="p">$</span> holdmap agents
<span class="v">Claude Code</span>  pid 51200 · 214 MB · 3% CPU · 1 stoppable
  folders   shop-api  ~/code/shop-api
  ports     :3001  shop-api (Vite)
  access    sandbox unknown · network :3001 only
<span class="p">$</span> holdmap agents claude --stop-ports --dry-run
<span class="d">Dry run: nothing was changed.</span></pre>
        </div>
        <div class="visual agents-shot">{["dark", "light"].map((t) => (
          <Picture src={t === "dark" ? agentsShot : agentsLight} formats={["avif"]} fallbackFormat="webp" widths={[640, 1280, 1920]} sizes={`(max-width: 1000px) calc(100vw - 80px), 720px`} alt="The Footprint map with Computer and Project zoom controls, agents, folders, tools and observed connections" loading="lazy" pictureAttributes={{ class: `only-${t}` }} />
        ))}</div>
      </li>
      <li class="card span-3 split">
        <div class="copy">
          <h3>Record a screen or window</h3>
          <p>Choose what to share, then save available MP4 or GIF exports locally. Record for up to two minutes with no microphone or system audio. Close and reopen the latest preview while Holdmap stays open; nothing is uploaded.</p>
          <p class="source-note">Each new video recording asks for a screen or window. Export formats depend on the encoder available in your app or browser.</p>
          <p class="source-note">PNG snapshots of the Holdmap view or a selected screen/window. An active recording can supply the still without another picker or stopping the video.</p>
          <a class="link-arrow" href={url("docs/desktop/#record-the-screen")}>Screen recording and saving <Icon name="ArrowRight" size={16} /></a>
          <a class="link-arrow" href={url("docs/desktop/#take-a-png-snapshot")}>PNG snapshots <Icon name="ArrowRight" size={16} /></a>
        </div>
        <div class="visual agents-shot">{["dark", "light"].map((t) => (
          <Picture src={t === "dark" ? screenRecordDark : screenRecordLight} formats={["avif"]} fallbackFormat="webp" widths={[640, 1280]} sizes={`(max-width: 1000px) calc(100vw - 80px), 720px`} alt="Screen recording consent explains local MP4 and GIF exports, the two-minute limit and the screen picker" loading="lazy" pictureAttributes={{ class: `only-${t}` }} />
        ))}</div>
      </li>
      <li class="card span-3 split agent-flow">
        <div class="copy">
          <h3>See agent connections and recorded calls</h3>
          <p><strong>Connections</strong> maps observed processes, listeners and live sockets. <strong>Calls</strong> shows tool and agent activity reported by integrations you configure. Find failures or missing completion, sort by reported duration, and inspect the reported parent context. Optional recording keeps sanitized metadata in memory on this computer; payload fields are excluded.</p>
          <p class="source-note">Socket relationships do not reveal messages. Session grouping does not imply communication; parent links come from supplied trace context.</p>
          <a class="link-arrow" href={url("docs/agents/#desktop-flow-connections-and-calls")}>Agent Flow and recording <Icon name="ArrowRight" size={16} /></a>
        </div>
        <div class="visual agents-shot">{["dark", "light"].map((t) => (
          <Picture src={t === "dark" ? agentFlowDark : agentFlowLight} formats={["avif"]} fallbackFormat="webp" widths={[640, 1280, 1920]} sizes={`(max-width: 1000px) calc(100vw - 80px), 720px`} alt="Example recorded agent trace with parallel tools, an explicit handoff and a timeline; the failed execution step is labelled" loading="lazy" pictureAttributes={{ class: `only-${t}` }} />
        ))}</div>
      </li>
      <li class="card">
        <div class="copy">
          <h3>MCP for AI agents</h3>
          <p>Claude, Cursor and VS Code can list ports, inspect agents and tools, find a free port and stop their own services. Stops require a reviewed, one-use confirmation. Protected targets are refused.</p>
        </div>
        <pre class="snippet term" tabindex="0" aria-label="Example MCP tools/call parameters"><span class="d">{"// tools/call parameters"}</span>
{"{"} <span class="c">"name"</span>: <span class="g">"list_agents"</span>, <span class="c">"arguments"</span>: {"{}"} {"}"}
<span class="d">→</span> Claude Code · Cursor · Docker Desktop
{"{"} <span class="c">"name"</span>: <span class="g">"stop_agent_ports"</span>,
  <span class="c">"arguments"</span>: {"{"} <span class="c">"agent"</span>: <span class="y">"claude"</span>,
    <span class="c">"dry_run"</span>: <span class="g">true</span> {"}"} {"}"}</pre>
      </li>
      <li class="card">
        <div class="copy">
          <h3>Scriptable to the core</h3>
          <p>Read reports support <code>--json</code>, stop actions support <code>--dry-run</code>, and exit codes mean something.</p>
        </div>
        <pre class="snippet term" tabindex="0" aria-label="Example CLI command"><span class="p">$</span> holdmap list --json \
    | jq '.entries[0].project.name'
<span class="g">"shop-web"</span></pre>
      </li>
      <li class="card">
        <div class="copy">
          <h3>A TUI, over SSH too</h3>
          <p>Run <code>holdmap</code> for a fast terminal UI. <code>holdmap ssh devbox</code> reads another machine without installing anything there.</p>
        </div>
        <pre class="snippet term" tabindex="0" aria-label="Example SSH command"><span class="p">$</span> holdmap ssh devbox
<span class="d">connected · 14 ports · linux</span></pre>
      </li>
    </ul>
  </div>
</section>

<style>
  .bento { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .card { display: flex; flex-direction: column; overflow: hidden; min-width: 0; }
  .span-2 { grid-column: span 2; }
  .span-3 { grid-column: span 3; }
  .copy { padding: 32px 32px 0; }
  h3 { margin: 0 0 8px; font-size: var(--fs-lg); line-height: 28px; font-weight: 600; letter-spacing: -0.012em; }
  p { margin: 0; max-width: 520px; color: var(--muted); font-size: var(--fs-md); line-height: 24px; }
  .copy .link-arrow { margin-top: 20px; }
  .source-note { margin-top: 12px; font-size: var(--fs-sm); line-height: 20px; }

  .visual { position: relative; flex: 1; min-height: 320px; margin-top: 32px; overflow: hidden; }
  .visual.short { min-height: 264px; }
  .visual :global(img) { display: block; max-width: none; height: auto; }
  .bleed :global(img) {
    position: absolute; left: 32px; top: 0;
    border: 1px solid var(--border-strong); border-right: 0; border-bottom: 0; border-top-left-radius: var(--r-md);
  }
  .stage { display: grid; place-items: center; padding: 0 32px 32px; min-height: 0; }
  .stage :global(img) { width: min(440px, 100%); border-radius: var(--r-lg); box-shadow: var(--shadow); }

  .split { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
  .split .copy { padding: 32px; }
  .graph { margin: 0; padding: 32px 32px 32px 0; min-height: 0; }
  .graph :global(img) { width: 720px; border-radius: var(--r-md); border: 1px solid var(--border); }
  .agents-shot { margin: 0; padding: 32px 32px 32px 0; min-height: 0; }
  .agents-shot :global(img) { width: 720px; border-radius: var(--r-md); border: 1px solid var(--border); }
  .snippet.inline { margin: 20px 0 0; }

  .snippet { margin: auto 16px 16px; padding: 16px; border-radius: var(--r-md); white-space: pre; overflow-x: auto; border: 1px solid var(--term-line-strong); }
  .card:has(.snippet:not(.inline)) .copy { padding-bottom: 24px; }

  @media (max-width: 1100px) {
    .split { grid-template-columns: minmax(0, 1fr); }
    .graph, .agents-shot { padding: 0 32px 32px; }
    .graph :global(img), .agents-shot :global(img) { width: 100%; }
  }
  @media (max-width: 1000px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .span-3 { grid-column: span 2; }
  }
  @media (max-width: 640px) {
    .bento { grid-template-columns: minmax(0, 1fr); }
    .span-2, .span-3 { grid-column: auto; }
    .copy, .split .copy { padding: 24px 24px 0; }
    .visual { min-height: 240px; margin-top: 24px; }
    .bleed :global(img) { left: 24px; }
    .stage { padding: 0 24px 24px; }
    .graph, .agents-shot { padding: 0 24px 24px; }
  }
</style>
