---
// The "patch bay": a field of sockets behind the hero. A few are bound (lit, labelled with a
// port) and pulse in turn, like listeners coming and going. Pure SVG + CSS; static when the
// visitor prefers reduced motion.
const COLS = 26, ROWS = 10, CELL = 64;
const lit: [number, number, string][] = [
  [3, 1, ":3000"], [22, 2, ":5173"], [5, 4, ":5432"], [20, 5, ":6379"], [1, 6, ":8080"],
  [24, 7, ":11434"], [4, 8, ":4000"], [21, 9, ":8000"], [24, 0, ":4321"], [2, 3, ":9229"],
];
const isLit = (c: number, r: number) => lit.some(([x, y]) => x === c && y === r);
const cells: [number, number][] = [];
for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) if (!isLit(c, r)) cells.push([c, r]);
const W = COLS * CELL, H = ROWS * CELL;
---
<svg class="bay" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMin slice" aria-hidden="true" focusable="false">
  <defs>
    <g id="sock">
      <rect x="-15" y="-11" width="30" height="22" rx="7" />
      <rect class="pin" x="-8" y="-5" width="4" height="10" rx="1.5" />
      <rect class="pin" x="4" y="-5" width="4" height="10" rx="1.5" />
    </g>
  </defs>
  <g class="idle">
    {cells.map(([c, r]) => <use href="#sock" x={c * CELL + CELL / 2} y={r * CELL + CELL / 2} />)}
  </g>
  {lit.map(([c, r, label], i) => (
    <g class="lit" style={`--i:${i}`} transform={`translate(${c * CELL + CELL / 2} ${r * CELL + CELL / 2})`}>
      <rect class="halo" x="-26" y="-20" width="52" height="40" rx="14" />
      <use href="#sock" />
      <text y="27" text-anchor="middle">{label}</text>
    </g>
  ))}
</svg>

<style>
  .bay {
    position: absolute; z-index: -2; left: 0; top: 0; width: 100%; height: 640px; pointer-events: none;
    mask-image: radial-gradient(ellipse 80% 90% at 50% 30%, #000 30%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse 80% 90% at 50% 30%, #000 30%, transparent 78%);
  }
  .idle use { fill: none; stroke: var(--grid-line); stroke-width: 1.2; }
  .idle :global(use) { color: var(--grid-line); }
  .bay :global(.pin) { fill: currentColor; stroke: none; }
  .idle { color: var(--grid-line); }
  .lit { color: #22d3ee; animation: bind 9s var(--ease) infinite; animation-delay: calc(var(--i) * -0.9s); }
  .lit:nth-of-type(3n) { color: #8e8cff; }
  .lit:nth-of-type(4n) { color: #47d18c; }
  .lit use { fill: color-mix(in srgb, currentColor 16%, transparent); stroke: currentColor; stroke-width: 1.4; }
  .halo { fill: currentColor; opacity: 0.08; }
  .lit text { fill: currentColor; font: 600 10.5px var(--mono); opacity: 0.85; }
  @keyframes bind {
    0%, 100% { opacity: 0.18; }
    12%, 46% { opacity: 1; }
    60% { opacity: 0.18; }
  }
  @media (prefers-reduced-motion: reduce) { .lit { animation: none; opacity: 0.7; } }
</style>
