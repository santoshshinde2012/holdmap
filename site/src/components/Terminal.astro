---
// Scripted CLI playback (asciinema-style, plain HTML). Server-rendered with the first session's
// full output so it reads fine without JS or with reduced motion; the player animates it.
// The default slot is the intro copy shown above the session list.
import Icon from "./Icon.astro";
import { chapters, toHtml } from "../lib/cli-demo";
const first = chapters[0];
---
<div class="player" data-player>
  <div class="side">
    <slot />
    <div class="chapters" role="tablist" aria-label="CLI sessions" aria-orientation="vertical">
      {chapters.map((c, i) => (
        <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} aria-controls="player-screen" data-chapter={c.id}>
          <span class="cmd">holdmap {c.label}</span>
          <span class="cap">{c.caption}</span>
        </button>
      ))}
    </div>
  </div>
  <div class="term-window">
    <div class="window-bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="window-title">~/code/shop-web — zsh</span>
      <button type="button" class="ctl" data-toggle aria-label="Pause the demo" hidden>
        <Icon name="Pause" size={14} class="i-pause" />
        <Icon name="Play" size={14} class="i-play" />
      </button>
      <span class="ctl-pad" aria-hidden="true"></span>
    </div>
    <div class="screen term" id="player-screen" role="tabpanel" aria-live="off" tabindex="0" aria-label="Terminal output">
<pre data-screen><span class="p">$</span> {first.cmd}
<Fragment set:html={first.out.map(toHtml).join("\n")} /></pre>
    </div>
  </div>
</div>

<style>
  .player { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 48px; align-items: start; margin-top: 128px; }
  .chapters { display: grid; gap: 4px; margin-top: 32px; margin-left: -12px; }
  .chapters button {
    display: grid; gap: 4px; padding: 10px 12px; border: 0; border-radius: var(--r-sm); background: transparent;
    text-align: left; cursor: pointer; color: var(--muted); transition: background-color 140ms, color 140ms;
  }
  .cmd { font: 500 var(--fs-sm)/20px var(--mono); color: var(--text-2); font-variant-ligatures: none; }
  .cap { display: none; font-size: var(--fs-sm); line-height: 20px; }
  .chapters button:hover { background: var(--surface-2); }
  .chapters button:hover .cmd { color: var(--text); }
  .chapters button[aria-selected="true"] { background: var(--surface-2); box-shadow: inset 0 0 0 1px var(--border); }
  .chapters button[aria-selected="true"] .cmd { color: var(--text); }
  .chapters button[aria-selected="true"] .cap { display: block; }
  .term-window .window-bar { gap: 12px; }
  .window-title { color: var(--term-dim); }
  .ctl, .ctl-pad { flex: none; width: 52px; }
  .ctl { display: inline-flex; align-items: center; justify-content: flex-end; height: 28px; padding: 0; border: 0; background: transparent; color: var(--term-dim); cursor: pointer; }
  .ctl:not([hidden]) + .ctl-pad { display: none; }
  .ctl:hover { color: var(--term-text); }
  .ctl:not([data-paused]) :global(.i-play), .ctl[data-paused] :global(.i-pause) { display: none; }
  .screen { height: 432px; overflow: auto; padding: 16px 20px; scrollbar-width: thin; scrollbar-color: #2a2a2e transparent; }
  pre { margin: 0; font: inherit; white-space: pre-wrap; }
  pre :global(.cursor) { display: inline-block; width: 8px; height: 16px; vertical-align: -3px; background: var(--term-text); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 1000px) {
    .player { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .chapters { grid-template-columns: repeat(6, auto); justify-content: start; margin-top: 24px; overflow-x: auto; scrollbar-width: none; }
    .chapters button { padding: 6px 12px; }
    .chapters button[aria-selected="true"] .cap { display: none; }
  }
  @media (max-width: 640px) {
    .screen { height: 400px; padding: 16px; }
    pre { white-space: pre; font-size: var(--fs-xs); line-height: 16px; }
  }
</style>
<script>
  import { chapters, toHtml } from "../lib/cli-demo";

  const root = document.querySelector<HTMLElement>("[data-player]");
  if (root) {
    const screen = root.querySelector<HTMLElement>("[data-screen]")!;
    const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]")!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-chapter]")];
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let index = 0, run = 0, paused = still, visible = false, timer = 0;

    const wait = (ms: number, id: number) => new Promise<boolean>((done) => {
      const step = () => {
        if (id !== run) return done(false);
        if (paused || !visible || document.hidden) { timer = window.setTimeout(step, 200); return; }
        done(true);
      };
      timer = window.setTimeout(step, ms);
    });

    const mark = (i: number) => tabs.forEach((t, j) => { t.setAttribute("aria-selected", String(j === i)); t.tabIndex = j === i ? 0 : -1; });
    const prompt = (cmd: string, cursor: boolean) => `<span class="p">$</span> ${cmd}${cursor ? '<span class="cursor"></span>' : ""}`;

    function render(i: number) {
      const c = chapters[i];
      screen.innerHTML = `${prompt(c.cmd, false)}\n${c.out.map(toHtml).join("\n")}`;
    }

    async function play(i: number) {
      const id = ++run;
      index = i; mark(i);
      const c = chapters[i];
      if (still) { render(i); return; }
      screen.innerHTML = prompt("", true);
      if (!(await wait(450, id))) return;
      for (let n = 1; n <= c.cmd.length; n++) {
        screen.innerHTML = prompt(c.cmd.slice(0, n), true);
        if (!(await wait(28 + Math.random() * 45, id))) return;
      }
      if (!(await wait(380, id))) return;
      let html = prompt(c.cmd, false);
      for (const line of c.out) {
        html += `\n${toHtml(line)}`;
        screen.innerHTML = html + '<span class="cursor"></span>';
        screen.parentElement!.scrollTop = screen.parentElement!.scrollHeight;
        if (!(await wait(line.includes("Proceed?") ? 900 : c.id === "list" ? 70 : 140, id))) return;
      }
      if (!(await wait(3600, id))) return;
      play((i + 1) % chapters.length);
    }

    tabs.forEach((t, i) => t.addEventListener("click", () => { clearTimeout(timer); play(i); }));
    root.querySelector('[role="tablist"]')!.addEventListener("keydown", (e) => {
      const k = (e as KeyboardEvent).key;
      const d = k === "ArrowRight" || k === "ArrowDown" ? 1 : k === "ArrowLeft" || k === "ArrowUp" ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      const n = (index + d + tabs.length) % tabs.length;
      tabs[n].focus(); clearTimeout(timer); play(n);
    });

    if (!still) {
      toggle.hidden = false;
      toggle.addEventListener("click", () => {
        paused = !paused;
        toggle.toggleAttribute("data-paused", paused);
        toggle.setAttribute("aria-label", paused ? "Play the demo" : "Pause the demo");
      });
    }

    let started = false;
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !started) { started = true; play(0); }
    }, { threshold: 0.3 }).observe(root);
  }
</script>
