---
import Logo from "./Logo.astro";
import { changelogUrl, contributingUrl, issuesUrl, licenseUrl, releasesUrl, repoUrl, securityUrl, tagline, url, version } from "../lib/site";

const cols: { title: string; links: [string, string][] }[] = [
  { title: "Product", links: [["Features", url("#features")], ["Live demo", url("#demo")], ["Install", url("#install")], ["Releases", releasesUrl]] },
  { title: "Guide", links: [["Getting started", url("docs/")], ["Agents, tools and apps", url("docs/agents/")], ["MCP for AI agents", url("docs/mcp/")], ["CLI reference", url("docs/cli/")]] },
  { title: "Project", links: [["GitHub", repoUrl], ["Changelog", changelogUrl], ["Security policy", securityUrl], ["Contributing", contributingUrl], ["Issues", issuesUrl]] },
];
---
<footer class="footer">
  <div class="wrap">
    <div class="top">
      <div class="about">
        <a class="brand" href={url()}><Logo size={20} id="pw-logo-footer" /><span>portwise</span></a>
        <p>{tagline}</p>
        <p class="ver">Latest: <a href={`${repoUrl}/releases/tag/v${version}`}>v{version}</a></p>
      </div>
      {cols.map((c) => (
        <nav aria-label={c.title}>
          <h2>{c.title}</h2>
          <ul>{c.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <div class="bottom">
      <p>Dual-licensed under <a href={licenseUrl}>MIT or Apache-2.0</a>. Built with Rust, Tauri and Svelte.</p>
      <p>No telemetry, on the app or this site.</p>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); padding: 64px 0 40px; font-size: var(--fs-ui); line-height: 20px; }
  .top { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 32px; }
  .brand { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-weight: 600; font-size: var(--fs-md); }
  .about p { color: var(--muted); max-width: 32ch; margin: 16px 0 0; }
  .ver { font-family: var(--mono); font-size: var(--fs-xs); }
  .ver a { color: var(--text-2); }
  h2 { margin: 0 0 12px; font-size: var(--fs-sm); line-height: 20px; font-weight: 500; color: var(--text); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  ul a { display: inline-block; padding: 4px 0; color: var(--muted); text-decoration: none; }
  ul a:hover { color: var(--text); }
  .bottom { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--border); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; color: var(--muted); font-size: var(--fs-sm); }
  .bottom p { margin: 0; }
  .bottom a { color: var(--text-2); }
  @media (max-width: 860px) { .top { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
</style>
