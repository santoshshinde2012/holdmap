---
import Logo from "./Logo.astro";
import { changelogUrl, contributingUrl, issuesUrl, licenseUrl, releasesUrl, repoUrl, securityUrl, url, version } from "../lib/site";

const cols: { title: string; links: [string, string][] }[] = [
  { title: "Product", links: [["Features", url("#features")], ["Live demo", url("#demo")], ["Install", url("#install")], ["Releases", releasesUrl]] },
  { title: "Guide", links: [["Getting started", url("docs/")], ["Project stacks", url("docs/projects/")], ["MCP for AI agents", url("docs/mcp/")], ["CLI reference", url("docs/cli/")]] },
  { title: "Project", links: [["GitHub", repoUrl], ["Changelog", changelogUrl], ["Security policy", securityUrl], ["Contributing", contributingUrl], ["Issues", issuesUrl]] },
];
---
<footer class="footer">
  <div class="wrap">
    <div class="top">
      <div class="about">
        <a class="brand" href={url()}><Logo size={24} id="pw-logo-footer" /><span>portwise</span></a>
        <p>See which ports are in use, why they're busy, and stop the right thing safely.</p>
        <p class="ver"><span class="dot" aria-hidden="true"></span>Latest: <a href={`${repoUrl}/releases/tag/v${version}`}>v{version}</a></p>
      </div>
      {cols.map((c) => (
        <nav aria-label={c.title}>
          <h2>{c.title}</h2>
          <ul>{c.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <div class="bottom">
      <p>Dual-licensed under <a href={licenseUrl}>MIT or Apache-2.0</a>. Built with Rust, Tauri and Svelte.</p>
      <p>No telemetry, on the app or this site.</p>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); background: var(--bg-2); padding: 56px 0 32px; font-size: 14.5px; }
  .top { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 32px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 700; font-size: 17px; }
  .about p { color: var(--muted); max-width: 34ch; margin: 14px 0 0; }
  .ver { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 13px; }
  .ver a { color: var(--text-2); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 4px color-mix(in srgb, var(--green) 20%, transparent); }
  h2 { margin: 0 0 12px; font-size: 13px; font-weight: 600; color: var(--text); letter-spacing: 0.02em; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  ul a { display: inline-block; padding: 4px 0; color: var(--muted); text-decoration: none; }
  ul a:hover { color: var(--text); }
  .bottom { margin-top: 44px; padding-top: 22px; border-top: 1px solid var(--border); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; color: var(--muted); font-size: 13.5px; }
  .bottom p { margin: 0; }
  .bottom a { color: var(--text-2); }
  @media (max-width: 860px) { .top { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
  @media (max-width: 420px) { .top { grid-template-columns: 1fr; } }
</style>
