---
import Icon from "./Icon.astro";
import InstallCommand from "./InstallCommand.astro";
import { url, repoUrl } from "../lib/site";
---
<section class="section final" aria-labelledby="final-title">
  <div class="wrap inner">
    <h2 class="h2" id="final-title">See every agent. <span class="soft">Free the right port.</span></h2>
    <p>Install the CLI in one line, or grab the desktop app.</p>
    <InstallCommand id="final-install" />
    <div class="row">
      <a class="btn btn-primary" href={url("#install")}><Icon name="Download" size={16} /> All downloads</a>
      <a class="btn btn-ghost" href={url("docs/")}>Read the guide</a>
      <a class="btn btn-ghost" href={repoUrl}><Icon name="github" size={16} /> View on GitHub</a>
    </div>
  </div>
</section>

<style>
  .inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
  p { margin: 16px 0 32px; color: var(--muted); font-size: var(--fs-sub); line-height: 28px; }
  .row { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 32px; }
  @media (max-width: 520px) { .row { flex-direction: column; width: 100%; } .row :global(.btn) { width: 100%; height: 44px; } }
</style>
