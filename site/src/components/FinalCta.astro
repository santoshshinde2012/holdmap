---
import Icon from "./Icon.astro";
import InstallCommand from "./InstallCommand.astro";
import { url, repoUrl } from "../lib/site";
---
<section class="final" aria-labelledby="final-title">
  <div class="wrap inner">
    <h2 id="final-title">Free port 3000. <span class="grad">Properly.</span></h2>
    <p>Install the CLI in one line, or grab the desktop app.</p>
    <InstallCommand id="final-install" size="md" />
    <div class="row">
      <a class="btn btn-ghost" href={url("#install")}><Icon name="Download" size={18} /> All downloads</a>
      <a class="btn btn-ghost" href={url("docs/")}><Icon name="BookOpen" size={18} /> Read the guide</a>
      <a class="btn btn-ghost" href={repoUrl}><Icon name="github" size={17} /> View on GitHub</a>
    </div>
  </div>
</section>

<style>
  .final { position: relative; overflow: hidden; padding-block: clamp(80px, 11vw, 140px); text-align: center; isolation: isolate; }
  .final::before {
    content: ""; position: absolute; z-index: -1; left: 50%; top: 50%; width: 900px; height: 420px; translate: -50% -50%;
    background: radial-gradient(closest-side, rgb(99 102 241 / 0.28), rgb(34 211 238 / 0.08) 60%, transparent); filter: blur(10px);
  }
  .inner { display: flex; flex-direction: column; align-items: center; }
  h2 { margin: 0; font-size: clamp(34px, 5.4vw, 64px); line-height: 1.04; letter-spacing: -0.045em; font-weight: 800; text-wrap: balance; }
  p { margin: 16px 0 32px; color: var(--muted); font-size: 18px; }
  .row { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 24px; }
</style>
