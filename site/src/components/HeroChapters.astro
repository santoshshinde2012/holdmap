---
// The hero video's chapters: they follow playback and seek on click (HeroVideo's script drives
// them). A vertical step list beside the laptop on wide screens, a compact row under it otherwise.
const chapters = [
  { title: "Find", text: "Search ports, agents, projects." },
  { title: "Explain", text: "Who holds it, and why it's busy." },
  { title: "Stop", text: "See the plan before anything runs." },
  { title: "Free", text: "Whole tree stopped, port verified." },
];
---
<ol class="steps" data-hero-chapters aria-label="Video chapters">
  {chapters.map((c, i) => (
    <li>
      <button type="button" data-chapter={i} aria-label={`Play from “${c.title}”: ${c.text}`}>
        <span class="bar" aria-hidden="true"><i></i></span>
        <span class="n">0{i + 1}</span>
        <span class="t">{c.title}</span>
        <span class="x">{c.text}</span>
      </button>
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; }
  button {
    position: relative; display: grid; grid-template-columns: 28px 64px minmax(0, 1fr); align-items: baseline; width: 100%;
    padding: 7px 0 7px 18px; border: 0; background: transparent; text-align: left; cursor: pointer;
    font-size: var(--fs-sm); line-height: 20px; color: var(--muted); transition: color 160ms var(--ease);
  }
  .bar { position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--border-strong); overflow: hidden; }
  .bar i { display: block; width: 100%; height: 100%; background: var(--accent); transform-origin: 50% 0; transform: scaleY(var(--p, 0)); }
  .n { font: 500 var(--fs-xs) var(--mono); }
  .t { font-weight: 500; color: var(--text-2); }
  .x { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  button:hover .t, [aria-current="step"] .t { color: var(--text); }
  button:hover .x, [aria-current="step"] .x { color: var(--text-2); }

  /* Stacked layout: a row of four under the device, progress along the top. */
  @media (max-width: 1199px) {
    .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
    button { display: flex; flex-wrap: wrap; align-content: flex-start; gap: 2px 8px; height: 100%; padding: 14px 0 4px; }
    .bar { right: 0; bottom: auto; width: auto; height: 2px; }
    .bar i { transform-origin: 0 50%; transform: scaleX(var(--p, 0)); }
    .x { flex-basis: 100%; white-space: normal; }
  }
  /* Too narrow for the descriptions: under the laptop at 1024-1199px, and on phones. */
  @media (min-width: 1024px) and (max-width: 1199px), (max-width: 640px) { .x { display: none; } button { padding-top: 12px; } }
</style>
