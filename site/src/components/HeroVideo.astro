---
// The hero's product video: a real recording of the desktop app (the live-demo build with sample
// data) on a CSS-drawn laptop, driven together with the chapter list (HeroChapters). The poster is
// a real <picture> (the LCP element); the video only loads once the hero is in view, and with
// reduced motion it waits for a click. Phones get a portrait cut in a compact device frame instead,
// because the laptop shot is unreadable at that size. Each cut exists in both themes.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import { url } from "../lib/site";
import deskDark from "../assets/hero/hero-poster-desktop-dark.png";
import deskLight from "../assets/hero/hero-poster-desktop-light.png";
import mobDark from "../assets/hero/hero-poster-mobile-dark.png";
import mobLight from "../assets/hero/hero-poster-mobile-light.png";

// Chapter start times (seconds) per cut: the "marks" in the meta.json that scripts/record-hero.mjs writes.
const cuts = {
  desktop: { duration: 21.3, starts: [0, 4.617, 8.717, 15.2] },
  mobile: { duration: 19.267, starts: [0, 4.617, 7.867, 11.517] },
};

const MOBILE = "(max-width: 640px)";
async function srcset(src: ImageMetadata, widths: number[], format: "avif" | "webp") {
  const out = await Promise.all(widths.map(async (w) => `${(await getImage({ src, width: w, format })).src} ${w}w`));
  return out.join(", ");
}
async function poster(desk: ImageMetadata, mob: ImageMetadata) {
  const dw = [576, 864, 1152, 1728], mw = [350, 700, 1050];
  const fallback = await getImage({ src: desk, width: 864, format: "webp" });
  return {
    mobAvif: await srcset(mob, mw, "avif"), mobWebp: await srcset(mob, mw, "webp"),
    deskAvif: await srcset(desk, dw, "avif"), deskWebp: await srcset(desk, dw, "webp"),
    src: fallback.src,
  };
}
const posters = { dark: await poster(deskDark, mobDark), light: await poster(deskLight, mobLight) };
const sizes = `${MOBILE} calc(100vw - 72px), (max-width: 1023px) calc(78vw - 52px), 640px`;
const files = { base: url("hero/") };
const alt = "A 21-second tour of the portwise desktop app: searching for shop, opening port 3000 (shop-web, Next.js, branch feat/checkout, 1.1 GB), opening the command palette, previewing the stop plan and freeing the port.";
---
<figure class="hero-video" data-hero-video data-base={files.base} data-cuts={JSON.stringify(cuts)} data-mobile={MOBILE}>
  <div class="device">
    <div class="lid">
      <span class="cam" aria-hidden="true"></span>
      <div class="screen">
        {(["dark", "light"] as const).map((t) => (
          <picture class:list={["poster", `only-${t}`]} data-poster>
            <source media={MOBILE} type="image/avif" srcset={posters[t].mobAvif} sizes={sizes} />
            <source media={MOBILE} type="image/webp" srcset={posters[t].mobWebp} sizes={sizes} />
            <source type="image/avif" srcset={posters[t].deskAvif} sizes={sizes} />
            <source type="image/webp" srcset={posters[t].deskWebp} sizes={sizes} />
            <img src={posters[t].src} alt={alt} width="1728" height="1080" decoding="async"
              loading={t === "dark" ? "eager" : "lazy"} fetchpriority={t === "dark" ? "high" : undefined} />
          </picture>
        ))}
        <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <video autoplay muted loop playsinline preload="metadata" disablepictureinpicture aria-hidden="true" tabindex="-1"></video>
        <button type="button" class="btn btn-ghost start" data-start hidden><Icon name="Play" size={16} /> Play the tour</button>
      </div>
    </div>
    <div class="deck" aria-hidden="true"></div>
  </div>
  <figcaption class="meta">
    <span>Recorded in the desktop app, with sample data.</span>
    <button type="button" class="pp" data-toggle aria-label="Pause the video" hidden>
      <Icon name="Pause" size={14} class="i-pause" /><Icon name="Play" size={14} class="i-play" />
      <span class="i-pause">Pause</span><span class="i-play">Play</span>
    </button>
  </figcaption>
</figure>

<style>
  .hero-video { margin: 0; }
  /* The laptop: every length is a share of its width (cqi), so it scales without breaking. */
  .device {
    --rim: #36373c; --deck-1: #4a4b51; --deck-2: #2c2d32; --deck-3: #1b1c1f; --floor: rgb(0 0 0 / 0.55);
    position: relative; container-type: inline-size; padding-bottom: 2.4%;
  }
  :global(:root[data-theme="light"]) .device { --rim: #c3c5cb; --deck-1: #f1f2f4; --deck-2: #d9dbe0; --deck-3: #b4b7be; --floor: rgb(10 10 11 / 0.2); }
  .lid {
    position: relative; width: 90%; margin-inline: auto; padding: 1.7cqi 1.5cqi 1.9cqi;
    border-radius: 2.6cqi 2.6cqi 0.5cqi 0.5cqi; background: #0b0b0d;
    box-shadow: 0 0 0 0.22cqi var(--rim), inset 0 0 0 1px rgb(255 255 255 / 0.05);
  }
  .cam { position: absolute; left: 50%; top: 0.6cqi; width: 0.55cqi; height: 0.55cqi; translate: -50% 0; border-radius: 50%; background: #1d1e24; box-shadow: inset 0 0 0 0.1cqi #2b2d36; }
  .deck {
    position: relative; height: 1.9cqi; margin-top: -0.1cqi;
    border-radius: 0.3cqi 0.3cqi 2.2cqi 2.2cqi / 0.3cqi 0.3cqi 1.9cqi 1.9cqi;
    background: linear-gradient(var(--deck-1), var(--deck-2) 45%, var(--deck-3));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.18);
  }
  /* The thumb scoop in the front edge. */
  .deck::before { content: ""; position: absolute; left: 50%; top: 0; width: 13%; height: 0.75cqi; translate: -50% 0; border-radius: 0 0 1cqi 1cqi; background: linear-gradient(var(--deck-3), var(--deck-2)); opacity: 0.7; }
  /* Soft contact shadow on the "floor". */
  .device::after { content: ""; position: absolute; z-index: -1; left: 3%; right: 3%; bottom: 0; height: 3.2cqi; border-radius: 50%; background: radial-gradient(closest-side, var(--floor), transparent); }

  .screen { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 0.35cqi; background: var(--bg); container-type: inline-size; --u: calc(100cqw / 1152); }
  /* A faint glass sheen, nothing more. */
  .screen::after { content: ""; position: absolute; inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(118deg, rgb(255 255 255 / 0.045), transparent 42%); }
  .screen video, .poster :global(img), .poster { position: absolute; inset: 0; width: 100%; height: 100%; }
  .poster :global(img) { object-fit: cover; }
  .screen video { object-fit: cover; opacity: 0; transition: opacity 240ms var(--ease); }
  .hero-video[data-playing] video { opacity: 1; }
  /* 1 unit = 1 CSS px of the 1152-wide recording, so the window controls sit in the app's own titlebar. */
  .lights { position: absolute; z-index: 1; left: calc(20 * var(--u)); top: calc(20 * var(--u)); display: flex; gap: calc(8 * var(--u)); }
  .lights i { width: calc(12 * var(--u)); height: calc(12 * var(--u)); border-radius: 50%; background: var(--surface-3); box-shadow: inset 0 0 0 1px var(--border-strong); }
  .start { position: absolute; z-index: 3; left: 50%; top: 50%; translate: -50% -50%; box-shadow: var(--shadow); }
  .start[hidden] { display: none; }

  .meta { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 90%; margin: 10px auto 0; font-size: var(--fs-xs); line-height: 20px; color: var(--muted); }
  .pp { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; margin-right: -8px; padding: 0 8px; border: 0; border-radius: var(--r-sm); background: transparent; color: var(--muted); font: inherit; cursor: pointer; }
  .pp:hover { color: var(--text); background: var(--surface-2); }
  .pp[hidden] { display: none; }
  .pp:not([data-paused]) :global(.i-play), .pp[data-paused] :global(.i-pause) { display: none; }

  /* Phones: a compact device frame around the portrait cut. */
  @media (max-width: 640px) {
    .device { padding-bottom: 0; }
    .lid { width: 100%; padding: 2.4cqi; border-radius: 7cqi; }
    .cam { top: 0.9cqi; width: 1.1cqi; height: 1.1cqi; }
    .screen { aspect-ratio: 5 / 7; border-radius: 4.8cqi; }
    .deck, .lights { display: none; }
    .device::after { bottom: -2.4cqi; height: 5cqi; }
    .meta { width: 100%; }
  }
</style>

<script>
  type Cut = { duration: number; starts: number[] };
  const root = document.querySelector<HTMLElement>("[data-hero-video]");
  if (root) {
    const video = root.querySelector("video")!;
    const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]")!;
    const start = root.querySelector<HTMLButtonElement>("[data-start]")!;
    const steps = [...document.querySelectorAll<HTMLButtonElement>("[data-hero-chapters] [data-chapter]")];
    const cuts = JSON.parse(root.dataset.cuts!) as Record<"desktop" | "mobile", Cut>;
    const small = matchMedia(root.dataset.mobile!);
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    const theme = () => (document.documentElement.dataset.theme === "light" ? "light" : "dark");
    const cut = () => (small.matches ? "mobile" : "desktop");
    let loaded = "", wanted = !still.matches, inView = false, raf = 0;

    if (still.matches) video.removeAttribute("autoplay");
    const name = () => `${root.dataset.base}hero-${cut()}-${theme()}`;
    function load(at = 0) {
      const n = name();
      if (n === loaded) return;
      loaded = n;
      video.replaceChildren(...[["webm", 'video/webm; codecs="av01.0.08M.08"'], ["mp4", 'video/mp4; codecs="avc1.640033"']].map(([ext, type]) => Object.assign(document.createElement("source"), { src: `${n}.${ext}`, type })));
      video.load();
      if (at) video.addEventListener("loadedmetadata", () => (video.currentTime = at), { once: true });
    }
    const sync = () => {
      const c = cuts[cut()], t = video.currentTime;
      let i = c.starts.length - 1;
      while (i > 0 && t < c.starts[i]) i--;
      steps.forEach((b, j) => {
        const s = c.starts[j], e = c.starts[j + 1] ?? c.duration;
        b.style.setProperty("--p", String(j < i ? 1 : j > i ? 0 : Math.min(1, (t - s) / (e - s))));
        if (j === i) b.setAttribute("aria-current", "step"); else b.removeAttribute("aria-current");
      });
    };
    const loop = () => { sync(); raf = requestAnimationFrame(loop); };
    const paused = (p: boolean) => {
      toggle.toggleAttribute("data-paused", p);
      toggle.setAttribute("aria-label", p ? "Play the video" : "Pause the video");
    };
    const play = () => { wanted = true; start.hidden = true; load(); video.play().catch(() => {}); };
    const pause = () => { wanted = false; video.pause(); };

    video.addEventListener("playing", () => { root.setAttribute("data-playing", ""); paused(false); cancelAnimationFrame(raf); loop(); });
    video.addEventListener("seeked", () => root.setAttribute("data-playing", ""));
    video.addEventListener("pause", () => { paused(true); cancelAnimationFrame(raf); sync(); });
    toggle.hidden = false;
    paused(!wanted);
    sync();
    if (still.matches) start.hidden = false;
    toggle.addEventListener("click", () => (video.paused ? play() : pause()));
    start.addEventListener("click", play);
    steps.forEach((b, i) => b.addEventListener("click", () => {
      load();
      const go = () => { video.currentTime = cuts[cut()].starts[i] + 0.01; sync(); play(); };
      if (video.readyState >= 1) go(); else video.addEventListener("loadedmetadata", go, { once: true });
    }));

    // Start once the hero is on screen (after the page has loaded, so the poster wins the race),
    // and pause while it's scrolled away.
    const ready = new Promise<void>((r) => (document.readyState === "complete" ? r() : addEventListener("load", () => r(), { once: true })));
    new IntersectionObserver(async ([e]) => {
      inView = e.isIntersecting;
      await ready;
      if (inView && wanted) play();
      else if (!inView && !video.paused) video.pause();
    }, { threshold: 0.25 }).observe(root);

    const swap = () => {
      if (!loaded) return;
      const i = steps.findIndex((b) => b.hasAttribute("aria-current"));
      const was = !video.paused;
      root.removeAttribute("data-playing");
      load(small.matches === loaded.includes("mobile") ? video.currentTime : cuts[cut()].starts[Math.max(0, i)]);
      if (was) video.play().catch(() => {});
    };
    window.addEventListener("portwise:theme", swap);
    small.addEventListener("change", swap);
  }
</script>
