---
import Icon from "./Icon.astro";
import { url } from "../lib/site";
const cards = [
  { icon: "Rocket", title: "Getting started", text: "Install, then your first minute: list, explain, stop.", href: url("docs/") },
  { icon: "Layers", title: "Project stacks", text: "Start a project's services in order with <code>.portwise.toml</code>.", href: url("docs/projects/") },
  { icon: "Terminal", title: "Shell hook", text: "Make “address already in use” explain itself.", href: url("docs/shell-hook/") },
  { icon: "Bot", title: "MCP for AI agents", text: "Set up Claude, Cursor or VS Code in one snippet.", href: url("docs/mcp/") },
  { icon: "LifeBuoy", title: "Troubleshooting", text: "PATH, hidden ports, first open, uninstalling.", href: url("docs/troubleshooting/") },
  { icon: "BookOpen", title: "CLI reference", text: "Every command and flag, generated from <code>--help</code>.", href: url("docs/cli/") },
];
---
<section class="section guide" aria-labelledby="guide-title">
  <div class="wrap">
    <div class="section-head split">
      <div>
        <span class="eyebrow">Guide</span>
        <h2 class="h2" id="guide-title">Short docs. Straight answers.</h2>
      </div>
      <a class="all" href={url("docs/")}>Open the guide <Icon name="ArrowRight" size={16} /></a>
    </div>
    <ul class="cards" role="list">
      {cards.map((c) => (
        <li>
          <a class="card" href={c.href}>
            <Icon name={c.icon} size={20} />
            <span class="t">{c.title}</span>
            <span class="d" set:html={c.text} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .split { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .all { display: inline-flex; align-items: center; gap: 8px; color: var(--accent); font-weight: 600; text-decoration: none; margin-bottom: 20px; }
  .all:hover { text-decoration: underline; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .card { display: grid; align-content: start; gap: 8px; height: 100%; padding: 24px; text-decoration: none; transition: border-color 160ms var(--ease), transform 160ms var(--ease); }
  .card:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); transform: translateY(-2px); }
  .card :global(svg) { color: var(--accent); margin-bottom: 8px; }
  .t { font-weight: 600; font-size: var(--fs-base); }
  .d { color: var(--muted); font-size: var(--fs-md); }
  .d :global(code) { font-size: 0.875em; padding: 0.125em 0.375em; white-space: nowrap; border-radius: var(--r-xs); background: var(--surface-2); color: var(--text-2); }
  @media (max-width: 900px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .cards { grid-template-columns: minmax(0, 1fr); } }
</style>
