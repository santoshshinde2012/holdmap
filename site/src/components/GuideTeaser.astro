---
import Icon from "./Icon.astro";
import { url } from "../lib/site";
const cards = [
  { icon: "Rocket", title: "Getting started", text: "Install, then your first minute: list, explain, stop.", href: url("docs/") },
  { icon: "Layers", title: "Project stacks", text: "Start a project's services in order with <code>.portwise.toml</code>.", href: url("docs/projects/") },
  { icon: "Terminal", title: "Shell hook", text: "Make “address already in use” explain itself.", href: url("docs/shell-hook/") },
  { icon: "Bot", title: "MCP for AI agents", text: "Set up Claude, Cursor or VS Code in one snippet.", href: url("docs/mcp/") },
  { icon: "LifeBuoy", title: "Troubleshooting", text: "PATH, hidden ports, first open, uninstalling.", href: url("docs/troubleshooting/") },
  { icon: "BookOpen", title: "CLI reference", text: "Every command and flag, generated from <code>--help</code>.", href: url("docs/cli/") },
];
---
<section class="section" aria-labelledby="guide-title">
  <div class="wrap">
    <div class="section-head head-row">
      <div>
        <span class="eyebrow">Guide</span>
        <h2 class="h2" id="guide-title">Short docs. <span class="soft">Straight answers.</span></h2>
      </div>
      <a class="link-arrow" href={url("docs/")}>Open the guide <Icon name="ArrowRight" size={16} /></a>
    </div>
    <ul class="cells" role="list">
      {cards.map((c) => (
        <li>
          <a class="cell" href={c.href}>
            <Icon name={c.icon} size={16} />
            <span class="t">{c.title}</span>
            <span class="d" set:html={c.text} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cells { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--border); border-left: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden; }
  .cells li { border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .cell { display: grid; align-content: start; gap: 8px; height: 100%; padding: 32px; text-decoration: none; transition: background-color 160ms var(--ease); }
  .cell:hover { background: var(--surface); }
  .cell :global(svg) { color: var(--muted); margin-bottom: 8px; }
  .cell:hover :global(svg) { color: var(--text); }
  .t { font-weight: 600; font-size: var(--fs-base); line-height: 24px; }
  .d { color: var(--muted); font-size: var(--fs-md); line-height: 24px; }
  @media (max-width: 900px) { .cells { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .cells { grid-template-columns: minmax(0, 1fr); } .cell { padding: 24px 20px; } }
</style>
