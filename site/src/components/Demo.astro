---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import Terminal from "./Terminal.astro";
import { url } from "../lib/site";
import posterDark from "../../../docs/screenshots/desktop-overview-dark.png";
import posterLight from "../../../docs/screenshots/desktop-overview-light.png";

const demo = url("demo/");
const tries: { act: string; label: string; keys: string[] }[] = [
  { act: "inspect", label: "Inspect :3000", keys: ["click"] },
  { act: "palette", label: "Command palette", keys: ["⌘", "K"] },
  { act: "graph", label: "Service graph", keys: ["G"] },
  { act: "stop", label: "Stop :3000", keys: ["⌫"] },
  { act: "help", label: "All shortcuts", keys: ["?"] },
];
const sizes = "(max-width: 1180px) calc(100vw - 40px), 1180px";
---
<section id="demo" class="section demo" aria-labelledby="demo-title">
  <div class="wrap">
    <div class="section-head center">
      <span class="eyebrow">Live demo</span>
      <h2 class="h2" id="demo-title">Try the real app. <span class="grad">Right here.</span></h2>
      <p class="lede">
        This is the actual portwise desktop interface, built for the browser and running on a sample
        machine. Click a port, open the palette, switch to the graph, stop something. Nothing touches
        your computer.
      </p>
    </div>

    <div class="device" data-demo data-src={demo}>
      <div class="window-bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="window-title">portwise · sample data</span>
        <a class="full" href={demo} target="_blank" rel="noopener">Full screen<span class="sr-only"> (opens in a new tab)</span> <Icon name="ExternalLink" size={14} /></a>
      </div>
      <div class="viewport" data-viewport>
        <div class="poster" data-poster>
          <Picture src={posterDark} formats={["avif"]} fallbackFormat="webp" widths={[640, 1180, 1800]} sizes={sizes} alt="" loading="lazy" pictureAttributes={{ class: "only-dark" }} />
          <Picture src={posterLight} formats={["avif"]} fallbackFormat="webp" widths={[640, 1180, 1800]} sizes={sizes} alt="" loading="lazy" pictureAttributes={{ class: "only-light" }} />
          <div class="poster-cta">
            <button type="button" class="btn btn-primary" data-start>
              <Icon name="Play" size={17} /> Start the live demo
            </button>
            <a class="btn btn-ghost small-only" href={demo}>Open the demo <Icon name="ArrowRight" size={16} /></a>
          </div>
        </div>
      </div>
    </div>

    <div class="tries" role="group" aria-label="Things to try in the demo">
      <span class="tries-label">Try</span>
      {tries.map((t) => (
        <button type="button" class="try" data-act={t.act} disabled>
          {t.label}
          {t.keys[0] !== "click" && <span class="keys">{t.keys.map((k) => <kbd data-mod={k === "⌘" ? "" : undefined}>{k}</kbd>)}</span>}
        </button>
      ))}
      <button type="button" class="try reset" data-act="reset" disabled><Icon name="RotateCcw" size={14} /> Reset</button>
    </div>

    <div class="cli">
      <div class="cli-copy">
        <span class="eyebrow">In your terminal</span>
        <h3>Same answers, one command away.</h3>
        <p>
          Every read command takes <code>--json</code>, every action has <code>--dry-run</code>, and exit
          codes tell scripts what happened. Pick a session or let it play.
        </p>
        <a class="more" href={url("docs/cli/")}>CLI reference <Icon name="ArrowRight" size={15} /></a>
      </div>
      <Terminal />
    </div>
  </div>
</section>

<style>
  .demo { background: linear-gradient(180deg, transparent, var(--bg-2) 18%, var(--bg-2) 82%, transparent); }
  .device { border-radius: 16px; overflow: hidden; background: var(--surface); box-shadow: var(--shadow), 0 40px 120px -40px var(--glow); }
  .window-bar { position: relative; }
  .full { position: absolute; right: 12px; display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--muted); text-decoration: none; padding: 4px 8px; border-radius: 6px; }
  .full:hover { color: var(--text); background: var(--surface-3); }
  .viewport { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--bg); }
  .viewport :global(iframe) {
    position: absolute; left: 0; top: 0; width: 1200px; height: 750px; border: 0;
    transform: scale(var(--s, 1)); transform-origin: 0 0; background: var(--bg);
  }
  .poster { position: absolute; inset: 0; z-index: 1; transition: opacity 400ms var(--ease); }
  .poster[data-hidden] { opacity: 0; pointer-events: none; }
  .poster :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top left; filter: saturate(0.9); }
  .poster-cta {
    position: absolute; inset: 0; display: grid; place-content: center; gap: 10px; justify-items: center;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--bg) 55%, transparent), transparent);
  }
  .poster-cta .btn-primary { --h: 50px; padding: 0 22px; font-size: 16px; }
  .small-only { display: none; }
  .tries { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px; margin-top: 20px; }
  .tries-label { font: 500 12px var(--mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-right: 4px; }
  .try {
    display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 12px; border-radius: 10px; cursor: pointer;
    border: 1px solid var(--border-strong); background: var(--surface); font-size: 13.5px; color: var(--text-2);
    transition: border-color 140ms, color 140ms, background-color 140ms;
  }
  .try:hover:not(:disabled) { border-color: color-mix(in srgb, var(--accent) 60%, var(--border-strong)); color: var(--text); }
  .try:disabled { opacity: 0.5; cursor: default; }
  .keys { display: inline-flex; gap: 3px; }
  .keys kbd { height: 20px; min-width: 20px; font-size: 11px; }
  .reset { color: var(--muted); }

  .cli { display: grid; grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.75fr); gap: clamp(28px, 4vw, 56px); align-items: center; margin-top: clamp(64px, 8vw, 104px); }
  .cli-copy h3 { margin: 12px 0 12px; font-size: clamp(24px, 2.8vw, 32px); line-height: 1.15; letter-spacing: -0.03em; }
  .cli-copy p { margin: 0; color: var(--muted); }
  .cli-copy code { font-size: 0.88em; padding: 2px 6px; border-radius: 6px; background: var(--surface-2); color: var(--text-2); }
  .more { display: inline-flex; align-items: center; gap: 6px; margin-top: 18px; color: var(--accent); text-decoration: none; font-weight: 600; }
  .more:hover { text-decoration: underline; }
  @media (max-width: 1060px) { .cli { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 720px) {
    .full, .device .window-title { display: none; }
    .small-only { display: inline-flex; }
    .poster-cta [data-start] { display: none; }
    .tries { display: none; }
  }
</style>

<script>
  // Load the live demo when it comes near (or on "Start"), scale its 1200×750 canvas to the
  // frame, and drive it from the "Try" buttons. Same origin, so we can reach into its document.
  const root = document.querySelector<HTMLElement>("[data-demo]");
  if (root) {
    const viewport = root.querySelector<HTMLElement>("[data-viewport]")!;
    const poster = root.querySelector<HTMLElement>("[data-poster]")!;
    const buttons = [...document.querySelectorAll<HTMLButtonElement>(".try")];
    const isMac = document.documentElement.dataset.os === "macos";
    if (!isMac) document.querySelectorAll(".tries kbd[data-mod]").forEach((k) => (k.textContent = "Ctrl"));
    let frame: HTMLIFrameElement | null = null;

    const fit = () => viewport.style.setProperty("--s", String(viewport.clientWidth / 1200));
    new ResizeObserver(fit).observe(viewport);

    const theme = () => (document.documentElement.dataset.theme === "light" ? "light" : "dark");
    function load() {
      if (frame || viewport.clientWidth < 600) return;
      frame = document.createElement("iframe");
      frame.title = "portwise live demo: the desktop app with sample data";
      frame.src = `${root!.dataset.src}?theme=${theme()}`;
      frame.addEventListener("load", () => {
        setTimeout(() => { poster.setAttribute("data-hidden", ""); buttons.forEach((b) => (b.disabled = false)); }, 500);
      }, { once: true });
      viewport.prepend(frame);
    }

    root.querySelector("[data-start]")?.addEventListener("click", () => { load(); setTimeout(() => frame?.focus(), 600); });
    new IntersectionObserver((entries, io) => {
      if (entries[0].isIntersecting) { load(); io.disconnect(); }
    }, { rootMargin: "300px 0px" }).observe(root);

    window.addEventListener("portwise:theme", (e) => {
      const doc = frame?.contentDocument;
      const t = (e as CustomEvent<string>).detail;
      if (!doc) return;
      doc.documentElement.dataset.theme = t;
      try { frame!.contentWindow!.localStorage.setItem("pw.theme", t); } catch { /* ignore */ }
    });

    const key = (k: string, mod = false) => {
      const doc = frame?.contentDocument;
      if (!doc) return;
      frame!.contentWindow!.focus();
      doc.body.dispatchEvent(new KeyboardEvent("keydown", { key: k, metaKey: mod && isMac, ctrlKey: mod && !isMac, bubbles: true, cancelable: true }));
    };
    const select = (port: number) => {
      const doc = frame?.contentDocument;
      const row = doc?.querySelector<HTMLElement>(`[id^="row-tcp:${port}:"]`);
      if (!row) return false;
      frame!.contentWindow!.focus();
      row.click();
      row.scrollIntoView({ block: "nearest" });
      return true;
    };
    const toList = () => {
      const doc = frame?.contentDocument;
      if (doc && !doc.getElementById("port-list")) key("g");
    };

    document.querySelector(".tries")?.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".try");
      if (!b || !frame) return;
      key("Escape");
      switch (b.dataset.act) {
        case "inspect": toList(); setTimeout(() => select(3000), 120); break;
        case "palette": key("k", true); break;
        case "graph": key("g"); break;
        case "stop": toList(); setTimeout(() => { if (select(3000)) setTimeout(() => key("Backspace"), 250); }, 120); break;
        case "help": key("?"); break;
        case "reset":
          buttons.forEach((x) => (x.disabled = true));
          frame.addEventListener("load", () => buttons.forEach((x) => (x.disabled = false)), { once: true });
          frame.src = `${root.dataset.src}?theme=${theme()}&r=${Date.now()}`;
          break;
      }
    });
  }
</script>
