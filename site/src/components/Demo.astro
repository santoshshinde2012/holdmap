---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import Terminal from "./Terminal.astro";
import { url } from "../lib/site";
import posterDark from "../../../docs/screenshots/desktop-overview-dark.png";
import posterLight from "../../../docs/screenshots/desktop-overview-light.png";

const demo = url("demo/");
const tries: { act: string; label: string; keys: string[] }[] = [
  { act: "inspect", label: "Inspect :3000", keys: [] },
  { act: "palette", label: "Command palette", keys: ["⌘", "K"] },
  { act: "graph", label: "Service graph", keys: ["G"] },
  { act: "agents", label: "Agents map", keys: ["⇧", "A"] },
  { act: "stop", label: "Stop :3000", keys: ["⌫"] },
  { act: "help", label: "Shortcuts", keys: ["?"] },
];
const sizes = "(max-width: 1184px) calc(100vw - 40px), 1120px";
---
<section class="section demo" aria-labelledby="demo-title">
  <div class="wrap">
    <div id="demo" class="stage">
      <div class="section-head head-row">
        <div>
          <span class="eyebrow">Live demo</span>
          <h2 class="h2" id="demo-title">Try the real app. <span class="soft">Right here.</span></h2>
        </div>
        <p class="aside">
          The actual desktop interface, running in your browser on a sample machine. Nothing touches
          your computer.
        </p>
      </div>

      <div class="window device" data-demo data-src={demo}>
        <div class="window-bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <div class="tries" role="group" aria-label="Things to try in the demo">
            {tries.map((t) => (
              <button type="button" class="try" data-act={t.act} disabled>
                {t.label}
                {t.keys.length > 0 && <span class="keys">{t.keys.map((k) => <kbd data-mod={k === "⌘" ? "" : undefined}>{k}</kbd>)}</span>}
              </button>
            ))}
            <button type="button" class="try reset" data-act="reset" disabled><Icon name="RotateCcw" size={14} /> Reset</button>
          </div>
          <a class="full" href={demo} target="_blank" rel="noopener">Full screen<span class="sr-only"> (opens in a new tab)</span> <Icon name="ExternalLink" size={14} /></a>
        </div>
        <div class="viewport" data-viewport>
          <div class="poster" data-poster>
            <Picture src={posterDark} formats={["avif"]} fallbackFormat="webp" widths={[640, 1120, 1680, 2240, 2880]} sizes={sizes} alt="" loading="lazy" pictureAttributes={{ class: "only-dark" }} />
            <Picture src={posterLight} formats={["avif"]} fallbackFormat="webp" widths={[640, 1120, 1680, 2240, 2880]} sizes={sizes} alt="" loading="lazy" pictureAttributes={{ class: "only-light" }} />
            <div class="poster-cta">
              <button type="button" class="btn btn-primary" data-start>
                <Icon name="Play" size={16} /> Start the live demo
              </button>
              <a class="btn btn-primary small-only" href={demo}>Open the live demo <Icon name="ArrowRight" size={16} /></a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <Terminal>
      <span class="eyebrow">In your terminal</span>
      <h3 class="cli-title">Same answers, one command away.</h3>
      <p class="cli-text">
        <code>portwise agents</code> maps agents and tools; every read command takes
        <code>--json</code>, every action has <code>--dry-run</code>, and exit codes tell scripts what
        happened.
      </p>
      <a class="link-arrow" href={url("docs/cli/")}>CLI reference <Icon name="ArrowRight" size={16} /></a>
    </Terminal>
  </div>
</section>

<style>
  .stage { scroll-margin-top: 8px; }
  .stage .section-head { margin-bottom: 32px; }
  .stage .h2 :global(.soft) { display: inline; }
  .aside { margin: 0; max-width: 400px; color: var(--muted); font-size: var(--fs-md); line-height: 24px; }
  .device .window-bar { gap: 16px; padding: 0 8px 0 16px; }
  .tries { display: flex; align-items: center; gap: 4px; flex: 1; min-width: 0; }
  .try {
    display: inline-flex; align-items: center; gap: 8px; height: 28px; padding: 0 8px; border-radius: var(--r-xs); cursor: pointer;
    border: 0; background: transparent; font-size: var(--fs-sm); font-weight: 500; color: var(--text-2); white-space: nowrap;
    transition: color 140ms, background-color 140ms;
  }
  .try:hover:not(:disabled) { color: var(--text); background: var(--surface-3); }
  .try:disabled { opacity: 0.5; cursor: default; }
  .keys { display: inline-flex; gap: 2px; }
  .keys kbd { height: 18px; min-width: 18px; padding: 0 4px; font-size: 11px; }
  .reset { color: var(--muted); margin-left: auto; gap: 4px; }
  .full {
    flex: none; display: inline-flex; align-items: center; gap: 4px; height: 28px; padding: 0 8px; border-radius: var(--r-xs);
    font-size: var(--fs-sm); font-weight: 500; color: var(--muted); text-decoration: none;
  }
  .full:hover { color: var(--text); background: var(--surface-3); }
  .viewport { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--bg); }
  .viewport :global(iframe) {
    position: absolute; left: 0; top: 0; width: 1280px; max-width: none; height: 720px; border: 0;
    transform: scale(var(--s, 1)); transform-origin: 0 0; background: var(--bg);
  }
  .poster { position: absolute; inset: 0; z-index: 1; transition: opacity 400ms var(--ease); }
  .poster[data-hidden] { opacity: 0; pointer-events: none; }
  .poster :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top left; }
  .poster-cta {
    position: absolute; inset: 0; display: grid; place-content: center;
    background: color-mix(in srgb, var(--bg) 40%, transparent);
  }
  .small-only { display: none; }

  .cli-title { margin: 0 0 12px; font-size: var(--fs-xl); line-height: 28px; font-weight: 600; letter-spacing: -0.015em; }
  .cli-text { margin: 0 0 16px; color: var(--muted); font-size: var(--fs-md); line-height: 24px; }

  @media (max-width: 1000px) {
    .device .window-bar { flex-wrap: wrap; height: auto; padding: 6px 8px 6px 16px; row-gap: 4px; }
    .tries { order: 3; flex-basis: 100%; flex-wrap: wrap; margin-left: -8px; }
    .reset { margin-left: 0; }
    .keys { display: none; }
    .full { margin-left: auto; }
  }
  @media (max-width: 720px) {
    .tries, .full { display: none; }
    .device .window-bar { height: 40px; flex-wrap: nowrap; }
    .small-only { display: inline-flex; }
    .poster-cta [data-start] { display: none; }
  }
</style>
<script>
  // Load the live demo when it comes near (or on "Start"), scale its 1280×720 canvas to the
  // frame, and drive it from the "Try" buttons. Same origin, so we can reach into its document.
  const root = document.querySelector<HTMLElement>("[data-demo]");
  if (root) {
    const viewport = root.querySelector<HTMLElement>("[data-viewport]")!;
    const poster = root.querySelector<HTMLElement>("[data-poster]")!;
    const buttons = [...document.querySelectorAll<HTMLButtonElement>(".try")];
    const isMac = document.documentElement.dataset.os === "macos";
    if (!isMac) document.querySelectorAll(".tries kbd[data-mod]").forEach((k) => (k.textContent = "Ctrl"));
    let frame: HTMLIFrameElement | null = null;

    const fit = () => viewport.style.setProperty("--s", String(viewport.clientWidth / 1280));
    new ResizeObserver(fit).observe(viewport);

    const theme = () => (document.documentElement.dataset.theme === "light" ? "light" : "dark");
    function load() {
      if (frame || viewport.clientWidth < 600) return;
      frame = document.createElement("iframe");
      frame.title = "portwise live demo: the desktop app with sample data";
      frame.src = `${root!.dataset.src}?theme=${theme()}`;
      frame.addEventListener("load", () => {
        setTimeout(() => { poster.setAttribute("data-hidden", ""); buttons.forEach((b) => (b.disabled = false)); }, 500);
      }, { once: true });
      viewport.prepend(frame);
    }

    root.querySelector("[data-start]")?.addEventListener("click", () => { load(); setTimeout(() => frame?.focus(), 600); });
    new IntersectionObserver((entries, io) => {
      if (entries[0].isIntersecting) { load(); io.disconnect(); }
    }, { rootMargin: "300px 0px" }).observe(root);

    window.addEventListener("portwise:theme", (e) => {
      const doc = frame?.contentDocument;
      const t = (e as CustomEvent<string>).detail;
      if (!doc) return;
      doc.documentElement.dataset.theme = t;
      try { frame!.contentWindow!.localStorage.setItem("pw.theme", t); } catch { /* ignore */ }
    });

    const key = (k: string, mod = false, shift = false) => {
      const doc = frame?.contentDocument;
      if (!doc) return;
      frame!.contentWindow!.focus();
      doc.body.dispatchEvent(new KeyboardEvent("keydown", { key: k, metaKey: mod && isMac, ctrlKey: mod && !isMac, shiftKey: shift, bubbles: true, cancelable: true }));
    };
    const select = (port: number) => {
      const doc = frame?.contentDocument;
      const row = doc?.querySelector<HTMLElement>(`[id^="row-tcp:${port}:"]`);
      if (!row) return false;
      frame!.contentWindow!.focus();
      row.click();
      row.scrollIntoView({ block: "nearest" });
      return true;
    };
    const toList = () => {
      const doc = frame?.contentDocument;
      if (doc && !doc.getElementById("port-list")) key("g");
    };

    document.querySelector(".tries")?.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".try");
      if (!b || !frame) return;
      key("Escape");
      switch (b.dataset.act) {
        case "inspect": toList(); setTimeout(() => select(3000), 120); break;
        case "palette": key("k", true); break;
        case "graph": key("g"); break;
        case "agents": key("A", false, true); break;
        case "stop": toList(); setTimeout(() => { if (select(3000)) setTimeout(() => key("Backspace"), 250); }, 120); break;
        case "help": key("?"); break;
        case "reset":
          buttons.forEach((x) => (x.disabled = true));
          frame.addEventListener("load", () => buttons.forEach((x) => (x.disabled = false)), { once: true });
          frame.src = `${root.dataset.src}?theme=${theme()}&r=${Date.now()}`;
          break;
      }
    });
  }
</script>
