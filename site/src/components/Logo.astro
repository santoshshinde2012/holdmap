---
// One generated web asset keeps navigation, footer and favicons aligned with the app.
import { url } from "../lib/site";
interface Props { size?: number; class?: string; id?: string }
const { size = 28, class: cls = "", id = "holdmap-logo" } = Astro.props;
---
<img {id} class={cls} src={url("favicon.svg")} width={size} height={size} alt="" aria-hidden="true" />
