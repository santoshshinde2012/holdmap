---
import Icon from "./Icon.astro";
import { downloads, install, checksumUrl, latestUrl, REPO, securityUrl, url, version, type Os } from "../lib/site";

const tabs: { key: Os | "source"; label: string }[] = [
  { key: "macos", label: "macOS" },
  { key: "linux", label: "Linux" },
  { key: "windows", label: "Windows" },
  { key: "source", label: "Source" },
];
const cmdFor = (k: string) => (k === "windows" ? install.ps : k === "source" ? install.cargo : install.sh);
const firstOpen: Record<string, string> = {
  macos: "The app isn't notarised yet. Open it once, then go to <b>System Settings › Privacy &amp; Security › Open Anyway</b> (macOS 14 and earlier: right-click the app, then <b>Open</b>). Or run <code>xattr -dr com.apple.quarantine /Applications/holdmap.app</code>.",
  windows: "The installer isn't code-signed yet. In “Windows protected your PC”, click <b>More info</b>, then <b>Run anyway</b>.",
  linux: "Make the AppImage executable (<code>chmod +x holdmap_*.AppImage</code>) or install the .deb / .rpm with your package manager.",
};
---
<section id="install" class="section" aria-labelledby="install-title">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Install</span>
      <h2 class="h2" id="install-title">Up and running in a minute. <span class="soft">One command, or a normal download.</span></h2>
      <p class="lede">The installer sets up the CLI, TUI and MCP server. The desktop app is a separate download. Latest release: <a href={latestUrl}>v{version}</a>.</p>
    </div>

    {version === "0.3.0" && (
      <p class="release-note" role="note"><Icon name="Info" size={18} /><span><strong>Linux desktop v0.3.0 predates the GLib security fixes.</strong> Build the desktop from current source until a patched release is available. The CLI, TUI, MCP server and macOS/Windows desktop are unaffected by this Linux dependency issue. <a href={`${securityUrl}#linux-glib-dependency-backports-unreleased`}>Security details</a>.</span></p>
    )}

    <div class="box">
    <div class="tabs" role="tablist" aria-label="Platform" data-tabs data-tabs-os>
      {tabs.map((t, i) => (
        <button type="button" role="tab" id={`in-tab-${t.key}`} aria-controls={`in-${t.key}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-key={t.key}>{t.label}</button>
      ))}
    </div>

    {tabs.map((t, i) => (
      <div class="panel" role="tabpanel" id={`in-${t.key}`} aria-labelledby={`in-tab-${t.key}`} hidden={i !== 0}>
        <div class="step">
          <h3><span class="num">1</span> {t.key === "source" ? "Build the CLI with Cargo" : "Install the CLI"}</h3>
          <div class="cmd">
            <code><span class="prompt" aria-hidden="true">{t.key === "windows" ? ">" : "$"} </span>{cmdFor(t.key)}</code>
            <button type="button" class="copy" data-copy={cmdFor(t.key)} aria-label={`Copy the ${t.label} install command`}><Icon name="Copy" size={16} class="i-copy" /><Icon name="Check" size={16} class="i-done" /></button>
          </div>
          <p class="hint">
            {t.key === "source"
              ? <Fragment>Needs Rust 1.95 or newer. The desktop app builds with <code>npm run tauri build</code> in <code>apps/desktop</code>; see <a href="https://github.com/santoshshinde2012/holdmap/blob/main/CONTRIBUTING.md">CONTRIBUTING.md</a>.</Fragment>
              : <Fragment>Installs to <code>{t.key === "windows" ? "%USERPROFILE%\\.local\\bin" : "~/.local/bin"}</code> and adds it to your <code>PATH</code> if needed. Then run <code>holdmap</code>.</Fragment>}
          </p>
        </div>
        {t.key !== "source" && (
          <div class="step">
            <h3><span class="num">2</span> Get the desktop app <span class="opt">Optional</span></h3>
            <div class="dl">
              {downloads.filter((d) => d.os === t.key).map((d) => (
                <a class:list={["dl-btn", { primary: d.primary }]} href={d.url}>
                  <Icon name="Download" size={16} />
                  <span><b>{d.label.split(" · ")[1]}</b><small>{d.detail}</small></span>
                </a>
              ))}
            </div>
            <p class="hint first-open"><Icon name="Info" size={16} /> <span set:html={firstOpen[t.key]} /></p>
          </div>
        )}
      </div>
    ))}
    </div>

    <div class="grid">
      <div class="card table-card">
        <h3>All desktop downloads</h3>
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">Platform</th><th scope="col">File</th><th scope="col">Checksum</th></tr></thead>
            <tbody>
              {downloads.map((d) => (
                <tr>
                  <th scope="row">{d.label}</th>
                  <td><a href={d.url}>{d.file}</a></td>
                  <td><a href={checksumUrl(d.checksum)} aria-label={`SHA-256 checksums for ${d.label}`}>.sha256</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div class="card verify">
        <h3>Verify what you downloaded</h3>
        <p>Every release ships SHA-256 checksums and GitHub build provenance.</p>
<pre class="term" tabindex="0"><code><span class="d"># the checksum file sits next to the download</span>
shasum -a 256 -c holdmap-desktop-macos-arm64.sha256
<span class="d"># Windows (PowerShell): compare with the .sha256 file</span>
Get-FileHash holdmap_{version}_x64-setup.exe
<span class="d"># where it was built, and from which commit</span>
gh attestation verify holdmap_{version}_aarch64.dmg \
  --repo {REPO}</code></pre>
        <p class="small">Homebrew is coming soon. Updating? Run the installer again; the desktop app checks GitHub Releases for updates. Trouble? See <a href={url("docs/troubleshooting/")}>troubleshooting</a>.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .lede a { color: var(--text-2); }
  .release-note { display: flex; align-items: flex-start; gap: 12px; margin: 0 0 24px; padding: 16px; border: 1px solid var(--border-strong); border-radius: var(--r-md); color: var(--text-2); background: var(--surface-2); font-size: var(--fs-ui); line-height: 22px; }
  .release-note :global(svg) { flex: none; margin-top: 2px; }
  .release-note strong { color: var(--text); }
  .release-note a { color: var(--text-2); }
  .box { border-radius: var(--r-lg); border: 1px solid var(--border); background: var(--surface); overflow: hidden; }
  .tabs { display: flex; gap: 24px; padding: 0 32px; border-bottom: 1px solid var(--border); overflow-x: auto; scrollbar-width: none; }
  .tabs button {
    height: 48px; padding: 0; margin-bottom: -1px; border: 0; border-bottom: 1px solid transparent; background: transparent;
    color: var(--muted); font-size: var(--fs-md); font-weight: 500; cursor: pointer; white-space: nowrap;
  }
  .tabs button:hover { color: var(--text); }
  .tabs button[aria-selected="true"] { color: var(--text); border-bottom-color: var(--text); }
  .panel { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .panel[hidden] { display: none; }
  .step { min-width: 0; padding: 32px; }
  .step + .step { border-left: 1px solid var(--border); }
  .panel > .step:only-child { grid-column: 1 / -1; max-width: 760px; }
  h3 { display: flex; align-items: center; gap: 12px; margin: 0 0 16px; font-size: var(--fs-base); line-height: 24px; font-weight: 600; letter-spacing: -0.01em; }
  .num { display: grid; place-items: center; width: 24px; height: 24px; border-radius: var(--r-xs); border: 1px solid var(--border-strong); color: var(--muted); font: 500 var(--fs-xs) var(--mono); }
  .opt { margin-left: auto; font-size: var(--fs-xs); font-weight: 500; color: var(--muted); }
  .cmd { display: flex; align-items: flex-start; gap: 12px; padding: 12px 8px 12px 16px; border-radius: var(--r-md); background: var(--surface-2); border: 1px solid var(--border); }
  .cmd code { flex: 1; min-width: 0; padding: 4px 0; font-size: var(--fs-sm); line-height: 24px; color: var(--text); white-space: pre-wrap; overflow-wrap: anywhere; font-variant-ligatures: none; }
  .prompt { color: var(--muted); user-select: none; }
  .copy { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: var(--r-sm); cursor: pointer; background: transparent; border: 0; color: var(--muted); }
  .copy:hover { color: var(--text); background: var(--surface-3); }
  .copy :global(.i-done) { display: none; color: var(--green); }
  .copy[data-copied] :global(.i-done) { display: block; }
  .copy[data-copied] :global(.i-copy) { display: none; }
  .hint { margin: 16px 0 0; font-size: var(--fs-ui); line-height: 22px; color: var(--muted); }
  .hint a { color: var(--text-2); }
  .first-open { display: flex; gap: 8px; align-items: flex-start; }
  .first-open :global(svg) { flex: none; margin-top: 3px; }
  .first-open :global(b) { color: var(--text-2); font-weight: 600; }
  .dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px; }
  .dl-btn { display: flex; align-items: center; gap: 12px; min-height: 56px; padding: 8px 16px; border-radius: var(--r-md); border: 1px solid var(--border-strong); background: var(--surface); text-decoration: none; transition: background-color 140ms; }
  .dl-btn:hover { background: var(--surface-2); }
  .dl-btn :global(svg) { flex: none; color: var(--muted); }
  .dl-btn span { display: grid; line-height: 20px; }
  .dl-btn b { font-size: var(--fs-ui); font-weight: 600; }
  .dl-btn small { font: var(--fs-xs)/16px var(--mono); color: var(--muted); }
  .dl-btn.primary { background: var(--accent); border-color: transparent; color: var(--on-accent); }
  .dl-btn.primary:hover { background: var(--accent-hover); }
  .dl-btn.primary :global(svg), .dl-btn.primary small { color: var(--on-accent); }
  .grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 16px; margin-top: 16px; }
  .card { padding: 32px; }
  .card h3 { margin-bottom: 8px; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: var(--fs-ui); }
  th, td { text-align: left; padding: 12px 16px 12px 0; border-bottom: 1px solid var(--border); white-space: nowrap; }
  thead th { font: 500 var(--fs-xs) var(--mono); color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  tbody th { font-weight: 500; color: var(--text-2); }
  tbody tr:last-child > * { border-bottom: 0; }
  td a { color: var(--text-2); font-family: var(--mono); font-size: var(--fs-sm); text-decoration-color: var(--border-strong); }
  td a:hover { color: var(--text); }
  .verify p { margin: 0; color: var(--muted); font-size: var(--fs-md); line-height: 24px; }
  .verify pre { margin: 16px 0; padding: 16px; border-radius: var(--r-md); overflow-x: auto; border: 1px solid var(--term-line-strong); }
  .small { font-size: var(--fs-ui) !important; line-height: 22px !important; }
  .small a { color: var(--text-2); }
  @media (max-width: 900px) {
    .grid, .panel { grid-template-columns: minmax(0, 1fr); }
    .step + .step { border-left: 0; border-top: 1px solid var(--border); }
  }
  @media (max-width: 560px) {
    .tabs { padding: 0 20px; gap: 20px; }
    .step, .card { padding: 24px 20px; }
    /* Downloads table as a list: platform on top, file and checksum below. */
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    tbody tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 16px; padding: 12px 0; border-bottom: 1px solid var(--border); }
    tbody tr:last-child { border-bottom: 0; }
    tbody th { grid-column: 1 / -1; }
    th, td { padding: 0; border: 0; white-space: normal; }
    td a { overflow-wrap: anywhere; }
  }
</style>
