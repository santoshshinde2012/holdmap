---
// Inline SVG icons from lucide-static (ISC), resolved at build time: no icon font, no runtime JS.
import * as lucide from "lucide-static";

interface Props { name: string; size?: number; class?: string; label?: string; stroke?: number }
const { name, size = 20, class: cls = "", label, stroke = 1.75 } = Astro.props;

const GITHUB = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>`;

const raw = name === "github" ? GITHUB : (lucide as unknown as Record<string, string>)[name];
if (!raw) throw new Error(`Unknown icon: ${name}`);
const a11y = label ? `role="img" aria-label="${label}"` : `aria-hidden="true" focusable="false"`;
const svg = raw.trim().replace(/<svg([\s\S]*?)>/, (_m, attrs: string) => {
  const kept = attrs.replace(/\s(width|height|class|stroke-width)="[^"]*"/g, "");
  return `<svg${kept} width="${size}" height="${size}"${name === "github" ? "" : ` stroke-width="${stroke}"`} class="icon ${cls}" ${a11y}>`;
});
---
<Fragment set:html={svg} />
