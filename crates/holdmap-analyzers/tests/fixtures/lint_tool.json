{
  "name": "lint",
  "inputSchema": {
    "type": "object"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "count": {
        "type": "integer"
      },
      "issues": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "level": {
              "type": "string"
            },
            "msg": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
