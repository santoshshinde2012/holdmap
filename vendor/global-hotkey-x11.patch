+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn call(manager: &GlobalHotKeyManager, operation: usize) -> crate::Result<()> {
+        let hotkey = HotKey::new(Some(Modifiers::ALT), Code::KeyK);
+        match operation {
+            0 => manager.register(hotkey),
+            1 => manager.unregister(hotkey),
+            2 => manager.register_all(&[hotkey]),
+            3 => manager.unregister_all(&[hotkey]),
+            _ => unreachable!(),
+        }
+    }
+
+    fn reply(message: ThreadMessage) -> Sender<crate::Result<()>> {
+        match message {
+            ThreadMessage::RegisterHotKey(_, tx)
+            | ThreadMessage::UnRegisterHotKey(_, tx)
+            | ThreadMessage::RegisterHotKeys(_, tx)
+            | ThreadMessage::UnRegisterHotKeys(_, tx) => tx,
+            ThreadMessage::DropThread => panic!("expected an operation"),
+        }
+    }
+
+    fn assert_unavailable(result: crate::Result<()>) {
+        assert!(matches!(
+            result,
+            Err(Error::OsError(error)) if error.kind() == std::io::ErrorKind::BrokenPipe
+        ));
+    }
+
+    #[test]
+    fn every_operation_rejects_a_closed_request_channel() {
+        let (thread_tx, thread_rx) = unbounded();
+        drop(thread_rx);
+        let manager = GlobalHotKeyManager { thread_tx };
+        for operation in 0..4 {
+            assert_unavailable(call(&manager, operation));
+        }
+    }
+
+    #[test]
+    fn every_operation_rejects_a_dropped_acknowledgment() {
+        for operation in 0..4 {
+            let (thread_tx, thread_rx) = unbounded();
+            let manager = GlobalHotKeyManager { thread_tx };
+            let worker = std::thread::spawn(move || {
+                drop(reply(thread_rx.recv().expect("request")));
+            });
+            assert_unavailable(call(&manager, operation));
+            worker.join().expect("owned worker");
+        }
+    }
+
+    #[test]
+    fn every_operation_preserves_the_worker_error() {
+        for operation in 0..4 {
+            let (thread_tx, thread_rx) = unbounded();
+            let manager = GlobalHotKeyManager { thread_tx };
+            let worker = std::thread::spawn(move || {
+                reply(thread_rx.recv().expect("request"))
+                    .send(Err(Error::FailedToRegister("owned fixture error".into())))
+                    .expect("acknowledgment");
+            });
+            assert!(
+                matches!(call(&manager, operation), Err(Error::FailedToRegister(error)) if error == "owned fixture error")
+            );
+            worker.join().expect("owned worker");
+        }
+    }
+}
